---
// Premium, reusable image dropzone — the compressor-grade look as a component.
// Preserves caller-supplied element IDs so existing tool scripts keep binding.
interface Props {
  /** id for the <label> dropzone (scripts listen on this). */
  dropId: string;
  /** id for the hidden <input type=file>. */
  inputId: string;
  /** accept attribute for the file input. */
  accept: string;
  /** Short format chips shown under the prompt, e.g. ["JPG","PNG","WEBP"]. */
  formats?: string[];
  /** Optional emoji/glyph shown in the icon tile (falls back to an upload icon). */
  icon?: string;
  title?: string;
  hint?: string;
}
const {
  dropId,
  inputId,
  accept,
  formats = [],
  icon,
  title = "Drop your image here",
  hint = "or click to browse from your device",
} = Astro.props;
---

<label
  id={dropId}
  for={inputId}
  class="group relative flex cursor-pointer flex-col items-center justify-center gap-4 overflow-hidden rounded-3xl border-2 border-dashed border-slate-300/70 bg-gradient-to-b from-slate-50 to-slate-100/50 px-8 py-20 text-center transition-all duration-300 hover:border-orange-500 hover:bg-orange-50/50 dark:border-slate-700 dark:from-slate-900/80 dark:to-slate-800/50 dark:hover:border-orange-500/50 dark:hover:bg-slate-800/80"
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:16px_16px] opacity-20 dark:bg-[radial-gradient(#475569_1px,transparent_1px)]"></div>

  <div class="relative flex h-20 w-20 items-center justify-center rounded-2xl bg-white text-4xl shadow-xl shadow-slate-200/50 transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105 dark:bg-slate-800 dark:shadow-slate-900/50">
    {icon ? (
      <span aria-hidden="true">{icon}</span>
    ) : (
      <svg class="h-10 w-10 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
      </svg>
    )}
  </div>

  <div class="relative z-10 space-y-1">
    <p class="text-xl font-bold text-slate-700 dark:text-slate-200">{title}</p>
    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">{hint}</p>
  </div>

  {formats.length > 0 && (
    <div class="relative z-10 mt-2 flex flex-wrap justify-center gap-2">
      {formats.map((f) => (
        <span class="rounded-lg bg-white/60 px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm backdrop-blur-md dark:bg-slate-800/60 dark:text-slate-300">{f}</span>
      ))}
    </div>
  )}

  <input id={inputId} type="file" accept={accept} class="hidden" />
</label>
