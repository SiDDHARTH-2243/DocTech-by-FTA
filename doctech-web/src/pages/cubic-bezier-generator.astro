---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Cubic-bezier Generator"
  subtitle="Design a CSS easing curve by dragging the handles, preview the motion, and copy the cubic-bezier()."
  wide
>
  <div class="space-y-5">
    <div class="grid gap-5 lg:grid-cols-[320px_1fr]">

      <!-- ═══ Curve Editor ═══ -->
      <div class="group relative z-10 rounded-2xl border border-slate-200 bg-gradient-to-b from-white to-slate-50 p-4 dark:border-slate-700 dark:from-slate-900 dark:to-slate-900/80">
        <!-- Subtle grid dots decoration -->
        <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl opacity-[0.035] dark:opacity-[0.06]" style="background-image:radial-gradient(circle,currentColor 1px,transparent 1px);background-size:16px 16px"></div>

        <!-- Live values badge -->
        <div class="relative mb-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-2 w-2 rounded-full bg-orange-500 shadow-sm shadow-orange-500/50"></div>
            <span id="cb-value-badge" class="font-mono text-xs font-bold tracking-tight text-slate-700 dark:text-slate-200">cubic-bezier(0.25, 0.1, 0.25, 1)</span>
          </div>
          <button id="cb-reset" type="button" class="rounded-md px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300" title="Reset to ease">↺ Reset</button>
        </div>

        <svg id="cb-svg" width="288" height="340" viewBox="0 0 288 340" class="relative mx-auto block touch-none select-none overflow-visible">
          <!-- Grid lines -->
          <defs>
            <pattern id="cb-minor-grid" width="28.8" height="28" patternUnits="userSpaceOnUse" x="0" y="40">
              <line x1="0" y1="0" x2="0" y2="28" stroke="currentColor" stroke-width="0.5" class="text-slate-100 dark:text-slate-800" />
              <line x1="0" y1="0" x2="28.8" y2="0" stroke="currentColor" stroke-width="0.5" class="text-slate-100 dark:text-slate-800" />
            </pattern>
          </defs>
          <rect x="0" y="40" width="288" height="280" fill="url(#cb-minor-grid)" />

          <!-- Axis labels -->
          <text x="144" y="335" text-anchor="middle" class="fill-slate-300 text-[10px] dark:fill-slate-600">time →</text>
          <text x="-175" y="10" text-anchor="middle" transform="rotate(-90)" class="fill-slate-300 text-[10px] dark:fill-slate-600">progress →</text>

          <!-- 0/1 labels -->
          <text x="-4" y="324" text-anchor="end" class="fill-slate-300 text-[9px] dark:fill-slate-600">0</text>
          <text x="-4" y="44" text-anchor="end" class="fill-slate-300 text-[9px] dark:fill-slate-600">1</text>
          <text x="0" y="335" text-anchor="start" class="fill-slate-300 text-[9px] dark:fill-slate-600">0</text>
          <text x="288" y="335" text-anchor="end" class="fill-slate-300 text-[9px] dark:fill-slate-600">1</text>

          <!-- Bounding box -->
          <rect x="0" y="40" width="288" height="280" fill="none" stroke="currentColor" stroke-width="1" class="text-slate-200 dark:text-slate-700" rx="2" />

          <!-- Diagonal reference line (linear) -->
          <line x1="0" y1="320" x2="288" y2="40" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" class="text-slate-200 dark:text-slate-700" />

          <!-- Handle lines -->
          <line id="cb-l1" stroke-width="1.5" stroke-dasharray="6 3" />
          <line id="cb-l2" stroke-width="1.5" stroke-dasharray="6 3" />

          <!-- The curve -->
          <path id="cb-curve" fill="none" stroke-width="3" stroke-linecap="round" />

          <!-- Handle circles (bigger, with glow) -->
          <circle id="cb-h1-glow" r="16" fill="none" />
          <circle id="cb-h2-glow" r="16" fill="none" />
          <circle id="cb-h1" r="9" style="cursor:grab" />
          <circle id="cb-h2" r="9" style="cursor:grab" />

          <!-- Start / End dots -->
          <circle cx="0" cy="320" r="4" class="fill-slate-300 dark:fill-slate-600" />
          <circle cx="288" cy="40" r="4" class="fill-slate-300 dark:fill-slate-600" />
        </svg>

        <!-- Control point coordinates -->
        <div class="relative mt-3 grid grid-cols-2 gap-2 text-center">
          <div class="rounded-lg bg-orange-500/8 px-2 py-1.5 ring-1 ring-orange-500/15 dark:bg-orange-500/10">
            <div class="text-[10px] font-bold tracking-wide text-orange-400 uppercase">P1</div>
            <div id="cb-p1-coords" class="font-mono text-xs font-bold text-orange-600 dark:text-orange-400">0.25, 0.1</div>
          </div>
          <div class="rounded-lg bg-blue-500/8 px-2 py-1.5 ring-1 ring-blue-500/15 dark:bg-blue-500/10">
            <div class="text-[10px] font-bold tracking-wide text-blue-400 uppercase">P2</div>
            <div id="cb-p2-coords" class="font-mono text-xs font-bold text-blue-600 dark:text-blue-400">0.25, 1.0</div>
          </div>
        </div>
      </div>

      <!-- ═══ Right panel ═══ -->
      <div class="space-y-4">

        <!-- Presets section -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
          <div class="mb-3 flex items-center gap-2">
            <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span class="text-xs font-bold tracking-wide text-slate-500 uppercase dark:text-slate-400">Presets</span>
          </div>
          <div id="cb-presets" class="grid grid-cols-3 gap-2 sm:grid-cols-4"></div>
        </div>

        <!-- Duration control -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
          <div class="mb-3 flex items-center gap-2">
            <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-xs font-bold tracking-wide text-slate-500 uppercase dark:text-slate-400">Duration</span>
          </div>
          <div class="flex items-center gap-3">
            <input id="cb-duration" type="range" min="0.2" max="3" step="0.1" value="1.4" class="flex-1 accent-orange-500" />
            <span id="cb-duration-val" class="w-10 text-right font-mono text-sm font-bold text-orange-500">1.4s</span>
          </div>
        </div>

        <!-- Multi-preview section -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
          <div class="mb-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="text-xs font-bold tracking-wide text-slate-500 uppercase dark:text-slate-400">Preview</span>
            </div>
            <button id="cb-replay" type="button" class="flex items-center gap-1 rounded-lg px-2 py-1 text-[11px] font-semibold text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Replay
            </button>
          </div>

          <!-- Ball preview -->
          <div class="space-y-3">
            <div>
              <div class="mb-1 text-[10px] font-semibold text-slate-400">Translation</div>
              <div class="relative h-10 rounded-xl bg-gradient-to-r from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-800/60">
                <div class="absolute inset-y-0 left-0 right-0 flex items-center px-2">
                  <div class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></div>
                </div>
                <div id="cb-ball" class="absolute top-1.5 left-1.5 h-7 w-7 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 shadow-md shadow-orange-500/30"></div>
              </div>
            </div>
            <div>
              <div class="mb-1 text-[10px] font-semibold text-slate-400">Scale</div>
              <div class="flex items-center justify-center rounded-xl bg-gradient-to-r from-slate-50 to-slate-100 py-2.5 dark:from-slate-800 dark:to-slate-800/60">
                <div id="cb-scale-box" class="h-7 w-7 rounded-lg bg-gradient-to-br from-blue-400 to-blue-600 shadow-md shadow-blue-500/30"></div>
              </div>
            </div>
            <div>
              <div class="mb-1 text-[10px] font-semibold text-slate-400">Rotation</div>
              <div class="flex items-center justify-center rounded-xl bg-gradient-to-r from-slate-50 to-slate-100 py-2.5 dark:from-slate-800 dark:to-slate-800/60">
                <div id="cb-rotate-box" class="h-7 w-7 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 shadow-md shadow-emerald-500/30"></div>
              </div>
            </div>
            <div>
              <div class="mb-1 text-[10px] font-semibold text-slate-400">Opacity</div>
              <div class="flex items-center justify-center rounded-xl bg-gradient-to-r from-slate-50 to-slate-100 py-2.5 dark:from-slate-800 dark:to-slate-800/60">
                <div id="cb-opacity-box" class="h-7 w-7 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 shadow-md shadow-purple-500/30"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Comparison (linear vs custom) -->
        <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
          <div class="mb-3 flex items-center gap-2">
            <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span class="text-xs font-bold tracking-wide text-slate-500 uppercase dark:text-slate-400">Compare</span>
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-14 text-[10px] font-semibold text-slate-400">linear</span>
              <div class="relative flex-1 h-7 rounded-lg bg-slate-50 dark:bg-slate-800">
                <div id="cb-compare-linear" class="absolute top-1 left-1 h-5 w-5 rounded-full bg-slate-300 dark:bg-slate-600"></div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-14 text-[10px] font-semibold text-orange-500">custom</span>
              <div class="relative flex-1 h-7 rounded-lg bg-slate-50 dark:bg-slate-800">
                <div id="cb-compare-custom" class="absolute top-1 left-1 h-5 w-5 rounded-full bg-orange-500 shadow-sm shadow-orange-500/30"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ CSS Output ═══ -->
    <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2 dark:border-slate-700 dark:bg-slate-800">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">CSS</span>
          <div class="flex gap-1">
            <button data-format="shorthand" class="cb-format-btn rounded-md bg-orange-500 px-2 py-0.5 text-[10px] font-semibold text-white">Shorthand</button>
            <button data-format="transition" class="cb-format-btn rounded-md border border-slate-300 px-2 py-0.5 text-[10px] font-semibold text-slate-500 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-400">Transition</button>
            <button data-format="animation" class="cb-format-btn rounded-md border border-slate-300 px-2 py-0.5 text-[10px] font-semibold text-slate-500 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-400">Animation</button>
          </div>
        </div>
        <button id="cb-copy" type="button" class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-semibold text-white transition-colors hover:bg-orange-600">Copy</button>
      </div>
      <pre id="cb-css" class="overflow-x-auto px-4 py-3 font-mono text-sm leading-relaxed dark:text-slate-100"></pre>
    </div>
  </div>

  <script>
    import "../scripts/tools/cubic-bezier-generator";
  </script>
</CenteredTool>
