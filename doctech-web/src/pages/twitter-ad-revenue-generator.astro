---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Twitter Ad Revenue Generator"
  subtitle="Generate a playful X / Twitter ad-revenue-share earnings card and download it as an image. Just for fun."
>
  <div class="lg:grid lg:grid-cols-[1fr_minmax(0,360px)] lg:items-start lg:gap-6">
    <div class="lg:sticky lg:top-4">
      <div class="flex justify-center overflow-auto rounded-2xl border border-slate-200 bg-slate-100 p-4 dark:border-slate-700 dark:bg-slate-950">
        <canvas id="tar-canvas" class="max-h-[480px] max-w-full rounded-xl shadow"></canvas>
      </div>
    </div>
    <div class="mt-5 space-y-4 lg:mt-0">
      <div class="grid grid-cols-2 gap-3 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">@handle</span><input id="tar-handle" type="text" value="jamieldn" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Theme</span><select id="tar-theme" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"><option value="dark">Dark</option><option value="light">Light</option></select></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Amount ($)</span><input id="tar-amount" type="number" min="0" step="0.01" value="24318.52" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Period</span><input id="tar-period" type="text" value="the last 30 days" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Impressions</span><input id="tar-impressions" type="number" min="0" value="8200000" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Engagements</span><input id="tar-engagements" type="number" min="0" value="431000" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
      </div>
      <button id="tar-download" type="button" class="w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600">Download PNG</button>
    </div>
  </div>

  <script>
    import "../scripts/tools/twitter-ad-revenue-generator";
  </script>
</CenteredTool>
