---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="SQL Formatter"
  subtitle="Beautify and standardise SQL for a dozen dialects — Postgres, MySQL, SQLite, BigQuery and more — with configurable keyword case and indentation."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-end gap-4">
        <div>
          <label class="field-label" for="sql-dialect">Dialect</label>
          <select id="sql-dialect" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="sql">Standard SQL</option>
            <option value="postgresql">PostgreSQL</option>
            <option value="mysql">MySQL</option>
            <option value="mariadb">MariaDB</option>
            <option value="sqlite">SQLite</option>
            <option value="bigquery">BigQuery</option>
            <option value="db2">Db2</option>
            <option value="plsql">Oracle PL/SQL</option>
            <option value="tsql">SQL Server (T-SQL)</option>
            <option value="spark">Spark</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="sql-case">Keywords</label>
          <select id="sql-case" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="upper">UPPERCASE</option>
            <option value="lower">lowercase</option>
            <option value="preserve">Preserve</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="sql-tab">Indent</label>
          <select id="sql-tab" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="2">2 spaces</option>
            <option value="4" selected>4 spaces</option>
            <option value="tab">Tabs</option>
          </select>
        </div>
        <button type="button" id="sql-run" class="ml-auto rounded-xl bg-orange-500 px-5 py-2 text-sm font-bold text-white transition-colors hover:bg-orange-600">Format</button>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <CodePane id="sql-in" label="SQL" placeholder="Paste a query…" language="sql" rows={18} actions={["sample", "upload", "clear"]} counts />
      <CodePane id="sql-out" label="Formatted" variant="output" language="sql" rows={18} actions={["copy", "download"]} counts />
    </div>
  </div>

  <script>
    import "../scripts/tools/sql-formatter";
  </script>
</CenteredTool>
