---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Social Media Image Resizer"
  subtitle="Resize and crop any image to the exact dimensions each platform wants — Instagram, Stories, YouTube, X, Facebook, LinkedIn and more."
>
  <label
    id="sr-drop"
    for="sr-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">📐</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Drag &amp; drop an image, or click to browse</span>
    <span class="text-xs text-slate-400">JPG · PNG · WebP</span>
    <input id="sr-input" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
  </label>

  <div id="sr-work" class="hidden space-y-4">
    <div class="flex min-h-[280px] items-center justify-center overflow-auto rounded-2xl border border-slate-200 bg-[repeating-conic-gradient(#e2e8f0_0_25%,transparent_0_50%)] bg-[length:20px_20px] p-3 dark:border-slate-700">
      <canvas id="sr-canvas" class="max-h-[440px] max-w-full rounded-lg shadow"></canvas>
    </div>
    <div class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-3 dark:border-slate-800 dark:bg-slate-900">
      <label class="block text-sm sm:col-span-1"><span class="mb-1 block font-semibold">Preset</span>
        <select id="sr-preset" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"></select>
      </label>
      <label class="block text-sm"><span class="mb-1 block font-semibold">Fit</span>
        <select id="sr-fit" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"><option value="cover">Cover (crop)</option><option value="contain">Contain (pad)</option></select>
      </label>
      <label class="block text-sm"><span class="mb-1 block font-semibold">Pad colour</span><input id="sr-bg" type="color" value="#ffffff" class="h-9 w-full cursor-pointer rounded-lg border border-slate-300 bg-transparent dark:border-slate-700" /></label>
    </div>
  </div>

  <div slot="rail" class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-sm font-semibold">Image Resizer</h2>
    <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">⚡ Local · no upload</span>
    <dl class="mt-4 space-y-2 text-sm">
      <div class="flex justify-between"><dt class="text-slate-500 dark:text-slate-400">Output</dt><dd id="sr-dims" class="font-mono font-semibold text-orange-500">—</dd></div>
    </dl>
    <button id="sr-download" type="button" disabled class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 dark:disabled:bg-slate-800 dark:disabled:text-slate-600">Download</button>
    <button id="sr-reset" type="button" class="mt-2 hidden w-full rounded-xl border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">Choose another image</button>
  </div>

  <script>
    import "../scripts/tools/social-image-resizer";
  </script>
</ToolPage>
