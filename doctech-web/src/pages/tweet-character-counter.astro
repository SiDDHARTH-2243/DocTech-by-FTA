---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Tweet / X Character Counter"
  subtitle="Count your post with X's real weighted rules — links count as 23, CJK characters as 2 — plus limits for Threads and Bluesky."
>
  <textarea
    id="tc-text"
    rows="6"
    placeholder="Start typing your post…"
    class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-base dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
  ></textarea>

  <div class="mt-4 grid gap-3 sm:grid-cols-4">
    <div id="tc-x-card" class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <div class="text-xs font-semibold text-slate-400 uppercase">X / Twitter</div>
      <div class="mt-1 text-2xl font-extrabold"><span id="tc-x">0</span><span class="text-sm font-medium text-slate-400">/280</span></div>
      <div id="tc-x-rem" class="text-xs text-slate-400">280 left</div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <div class="text-xs font-semibold text-slate-400 uppercase">Threads</div>
      <div class="mt-1 text-2xl font-extrabold"><span id="tc-threads">0</span><span class="text-sm font-medium text-slate-400">/500</span></div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <div class="text-xs font-semibold text-slate-400 uppercase">Bluesky</div>
      <div class="mt-1 text-2xl font-extrabold"><span id="tc-bsky">0</span><span class="text-sm font-medium text-slate-400">/300</span></div>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <div class="text-xs font-semibold text-slate-400 uppercase">Totals</div>
      <div class="mt-1 text-sm"><span id="tc-chars" class="font-bold">0</span> chars</div>
      <div class="text-sm"><span id="tc-words" class="font-bold">0</span> words</div>
    </div>
  </div>

  <script>
    import "../scripts/tools/tweet-character-counter";
  </script>
</CenteredTool>
