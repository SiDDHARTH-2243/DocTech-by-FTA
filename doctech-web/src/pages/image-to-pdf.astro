---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Image → PDF"
  subtitle="Convert JPG, PNG, WebP, or BMP images into a multi-page PDF. Each image becomes one page. Processed entirely in your browser."
>
  <div id="img-grid" class="mb-4 flex flex-wrap justify-center gap-4"></div>

  <label
    id="img-dropzone"
    for="img-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🖼️</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop images here, or click to browse
    </span>
    <span class="text-xs text-slate-400">JPG · PNG · WebP · BMP — multiple files OK</span>
    <input
      id="img-input"
      type="file"
      accept="image/png,image/jpeg,image/webp,image/bmp"
      multiple
      class="hidden"
    />
  </label>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Image → PDF</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      <span id="img-count" class="font-bold text-orange-500">0</span> images loaded
    </p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      ⚡ Local · no upload
    </span>
    <button
      id="img-btn"
      type="button"
      disabled
      class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 dark:disabled:bg-slate-800 dark:disabled:text-slate-600"
    >
      Convert to PDF
    </button>
  </div>

  <script>
    import "../scripts/tools/image-to-pdf";
  </script>
</ToolPage>
