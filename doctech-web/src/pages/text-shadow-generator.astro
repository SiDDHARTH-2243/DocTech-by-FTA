---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Text Shadow Generator"
  subtitle="Stack multiple text-shadow layers, tune font & effect, pick a preset — then copy the CSS."
>
  <!-- ════════════════════════ IMMERSIVE STAGE (pinned) ════════════════════════ -->
  <div
    id="ts-stage"
    class="relative flex min-h-[280px] items-center justify-center overflow-hidden rounded-2xl shadow-sm transition-colors duration-300 lg:sticky lg:top-4 lg:z-20"
    style="background:#0f172a"
  >
    <!-- Subtle grid pattern overlay -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.04]"
      style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 32px 32px"
    ></div>

    <!-- Editable preview text -->
    <div
      id="ts-preview-wrap"
      class="relative z-10 w-full max-w-3xl px-8 text-center"
    >
      <div
        id="ts-preview"
        contenteditable="true"
        spellcheck="false"
        class="cursor-text select-text break-words font-extrabold leading-none tracking-tight outline-none"
        style="font-size:72px;color:#ffffff;font-family:'Inter',sans-serif"
        >DocTech</div
      >
      <p class="mt-3 text-center text-[11px] font-medium tracking-widest text-white/20 uppercase">
        Click text to edit
      </p>
    </div>

    <!-- Stage bg controls pill (top-right) -->
    <div
      class="absolute top-3 right-3 z-20 flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 backdrop-blur-sm"
    >
      <span class="text-[11px] font-semibold text-white/50">Canvas</span>
      <input
        id="ts-canvas"
        type="color"
        value="#0f172a"
        title="Canvas background"
        class="h-5 w-8 cursor-pointer rounded border-0 bg-transparent p-0 outline-none"
      />
    </div>
  </div>

  <!-- ════════════════════════ MAIN CONTROLS ════════════════════════ -->
  <div class="mt-5 lg:grid lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-5">

    <!-- LEFT COLUMN: font settings + layer editor + CSS -->
    <div class="space-y-4">

      <!-- Font & text controls -->
      <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <p class="mb-3 text-sm font-semibold">Text & Font</p>
        <div class="grid gap-4 sm:grid-cols-2">
          <!-- Font family -->
          <div>
            <label class="mb-1.5 block text-xs font-semibold text-slate-500" for="ts-font">Font</label>
            <select
              id="ts-font"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
            >
              <option value="'Inter', sans-serif">Inter</option>
              <option value="'Outfit', sans-serif">Outfit</option>
              <option value="'Playfair Display', serif">Playfair Display</option>
              <option value="'Roboto Mono', monospace">Roboto Mono</option>
              <option value="'Dancing Script', cursive">Dancing Script</option>
              <option value="'Bebas Neue', sans-serif">Bebas Neue</option>
              <option value="'Abril Fatface', serif">Abril Fatface</option>
              <option value="Georgia, serif">Georgia</option>
            </select>
          </div>

          <!-- Text color -->
          <div>
            <label class="mb-1.5 block text-xs font-semibold text-slate-500" for="ts-text-color">Text Color</label>
            <div class="flex items-center gap-2">
              <input
                id="ts-text-color"
                type="color"
                value="#ffffff"
                class="h-9 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700"
              />
              <span id="ts-text-color-hex" class="font-mono text-xs text-slate-500">#ffffff</span>
            </div>
          </div>

          <!-- Font size -->
          <div>
            <label class="mb-1.5 block text-xs font-semibold text-slate-500" for="ts-size">
              Size <span id="ts-size-val" class="text-orange-500">72</span>px
            </label>
            <input id="ts-size" type="range" min="24" max="160" value="72" class="w-full accent-orange-500" />
          </div>

          <!-- Font weight -->
          <div>
            <label class="mb-1.5 block text-xs font-semibold text-slate-500">Weight</label>
            <div
              id="ts-weight-group"
              class="inline-flex rounded-lg border border-slate-300 p-0.5 dark:border-slate-700"
            >
              <button type="button" data-val="400" class="rounded-md px-2.5 py-1 text-xs font-semibold">Regular</button>
              <button type="button" data-val="600" class="rounded-md px-2.5 py-1 text-xs font-semibold">Semi</button>
              <button type="button" data-val="800" class="rounded-md px-2.5 py-1 text-xs font-semibold">Extra Bold</button>
              <button type="button" data-val="900" class="rounded-md px-2.5 py-1 text-xs font-semibold">Black</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Active layer editor -->
      <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <div class="mb-4 flex items-center justify-between">
          <span class="text-sm font-semibold">
            Editing <span id="ts-active-name" class="text-orange-500">Layer 1</span>
          </span>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            [
              ["ts-x", "Offset X", -40, 40, 2, "px"],
              ["ts-y", "Offset Y", -40, 40, 2, "px"],
              ["ts-blur", "Blur", 0, 60, 4, "px"],
              ["ts-alpha", "Opacity", 0, 100, 50, "%"],
            ].map(([id, label, min, max, val, unit]) => (
              <div>
                <label class="mb-1.5 block text-xs font-semibold text-slate-500" for={id}>
                  {label} <span id={`${id}-val`} class="text-orange-500">{val}</span>{unit}
                </label>
                <input
                  id={id}
                  type="range"
                  min={min}
                  max={max}
                  value={val}
                  class="w-full accent-orange-500"
                />
              </div>
            ))
          }
          <div>
            <label class="mb-1.5 block text-xs font-semibold text-slate-500" for="ts-layer-color">Shadow Color</label>
            <div class="flex items-center gap-2">
              <input
                id="ts-layer-color"
                type="color"
                value="#f97316"
                class="h-9 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700"
              />
              <span id="ts-layer-color-hex" class="font-mono text-xs text-slate-500">#f97316</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CSS output -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
        <div
          class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2 dark:border-slate-700 dark:bg-slate-800"
        >
          <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">CSS</span>
          <button
            id="ts-copy"
            type="button"
            class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-semibold text-white transition-colors hover:bg-orange-600"
            >Copy</button
          >
        </div>
        <pre id="ts-css" class="overflow-x-auto px-4 py-3 font-mono text-xs leading-relaxed dark:text-slate-100"></pre>
      </div>
    </div>

    <!-- RIGHT COLUMN: layer stack + presets -->
    <div class="mt-4 space-y-4 lg:mt-0">

      <!-- Shadow layers -->
      <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <div class="mb-3 flex items-center justify-between">
          <span class="text-sm font-semibold">Shadow Layers</span>
          <button
            id="ts-add"
            type="button"
            class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-semibold text-white transition-colors hover:bg-orange-600"
            >+ Add</button
          >
        </div>
        <div id="ts-layers" class="space-y-2"></div>
      </div>

      <!-- Presets -->
      <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <div class="mb-3 flex items-center justify-between">
          <span class="text-sm font-semibold">Presets</span>
          <div class="flex gap-2">
            <button
              id="ts-shuffle"
              type="button"
              class="rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
              >🎲</button
            >
            <button
              id="ts-reset"
              type="button"
              class="rounded-lg border border-slate-300 px-2.5 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800"
              >Reset</button
            >
          </div>
        </div>
        <div id="ts-presets" class="grid grid-cols-2 gap-2"></div>
      </div>

    </div>
  </div>

  <script>
    import "../scripts/tools/text-shadow-generator";
  </script>
</CenteredTool>
