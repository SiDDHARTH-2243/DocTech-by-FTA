---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Hash Generator"
  subtitle="Compute SHA-1, SHA-256, SHA-384 and SHA-512 hashes of any text instantly — all in your browser via the Web Crypto API."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <label class="field-label" for="hash-input">Text to hash</label>
      <textarea id="hash-input" rows="5" placeholder="Type or paste text…" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">abc</textarea>
    </div>

    {[
      ["SHA-1", "hash-sha1"],
      ["SHA-256", "hash-sha256"],
      ["SHA-384", "hash-sha384"],
      ["SHA-512", "hash-sha512"],
    ].map(([label, id]) => (
      <div class="tool-panel">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">{label}</span>
          <button data-copy={id} type="button" class="text-xs font-bold text-orange-500 transition-colors hover:text-orange-600">Copy</button>
        </div>
        <code id={id} class="block break-all rounded-xl bg-slate-50 px-3 py-2.5 font-mono text-xs text-slate-700 dark:bg-slate-800/50 dark:text-slate-200">—</code>
      </div>
    ))}
  </div>

  <script>
    import "../scripts/tools/hash-generator";
  </script>
</CenteredTool>
