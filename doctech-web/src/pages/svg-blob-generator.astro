---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="SVG Blob Generator"
  subtitle="Generate random organic blob shapes and copy them as SVG or download — tweak complexity, randomness and color."
>
  <div class="lg:grid lg:grid-cols-[1fr_minmax(0,360px)] lg:items-start lg:gap-6">
    <!-- Preview -->
    <div class="lg:sticky lg:top-4">
      <div id="blob-preview" class="flex min-h-[320px] items-center justify-center rounded-3xl border border-slate-200 bg-gradient-to-b from-slate-50 to-slate-100/50 p-8 shadow-sm dark:border-slate-800 dark:from-slate-900 dark:to-slate-950"></div>
    </div>

    <!-- Controls + code -->
    <div class="mt-5 space-y-5 lg:mt-0">
      <div class="tool-panel space-y-5">
        <div class="flex items-center justify-between">
          <h3 class="font-bold text-slate-800 dark:text-slate-100">Shape</h3>
          <button id="blob-shuffle" type="button" class="rounded-lg bg-orange-500 px-3 py-1.5 text-xs font-bold text-white shadow-sm shadow-orange-500/30 transition-all hover:-translate-y-0.5 hover:bg-orange-600">🎲 Shuffle</button>
        </div>
        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Complexity</span>
            <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-400"><span id="blob-points-val">6</span></span>
          </div>
          <input id="blob-points" type="range" min="3" max="12" value="6" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 outline-none dark:bg-slate-700" />
        </div>
        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Randomness</span>
            <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-400"><span id="blob-rand-val">40</span>%</span>
          </div>
          <input id="blob-rand" type="range" min="0" max="80" value="40" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 outline-none dark:bg-slate-700" />
        </div>
        <div class="flex items-center gap-2">
          <label class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" for="blob-color">Color</label>
          <input id="blob-color" type="color" value="#f97316" class="h-8 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700" />
          <span id="blob-color-hex" class="font-mono text-xs text-slate-500">#f97316</span>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-slate-200 shadow-sm dark:border-slate-800">
        <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2.5 dark:border-slate-800 dark:bg-slate-800/60">
          <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">SVG</span>
          <div class="flex gap-2">
            <button id="blob-copy" type="button" class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-bold text-white shadow-sm shadow-orange-500/30 transition-all hover:-translate-y-0.5 hover:bg-orange-600">Copy</button>
            <button id="blob-download" type="button" class="rounded-lg border border-slate-200 px-3 py-1 text-xs font-bold text-slate-600 transition-colors hover:border-orange-400 hover:text-orange-600 dark:border-slate-700 dark:text-slate-300 dark:hover:text-orange-400">Download</button>
          </div>
        </div>
        <pre id="blob-svg" class="max-h-48 overflow-auto bg-white px-4 py-3 font-mono text-xs whitespace-pre-wrap dark:bg-slate-900 dark:text-slate-100"></pre>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/svg-blob-generator";
  </script>
</CenteredTool>
