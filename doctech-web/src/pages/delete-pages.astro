---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Delete Pages"
  subtitle="Click on pages to select them for deletion, then download the trimmed PDF. Processed entirely in your browser."
>
  <label
    id="delete-dropzone"
    for="delete-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🗑️</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="delete-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="delete-opts" class="mt-5 hidden">
    <p id="delete-info" class="mb-4 text-sm font-semibold text-red-600 dark:text-red-400"></p>
    <div id="delete-grid" class="flex flex-wrap justify-center gap-4"></div>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Delete Pages</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      <span id="delete-count" class="font-bold text-orange-500">0</span> pages ·
      <span id="delete-selected" class="font-bold text-red-500">0</span> selected
    </p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      ⚡ Local · no upload
    </span>
    <button
      id="delete-btn"
      type="button"
      disabled
      class="mt-4 w-full rounded-xl bg-red-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-600 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 dark:disabled:bg-slate-800 dark:disabled:text-slate-600"
    >
      Delete Selected Pages
    </button>
  </div>

  <script>
    import "../scripts/tools/delete-pages";
  </script>
</ToolPage>
