---
import ToolPage from "../components/ToolPage.astro";
import PremiumDropzone from "../components/PremiumDropzone.astro";
---

<ToolPage
  title="Image Color Extractor"
  subtitle="Extract the dominant colors from an image and get every HEX code as a palette. Runs entirely in your browser."
>
  <PremiumDropzone
    dropId="ext-drop"
    inputId="ext-input"
    accept="image/png,image/jpeg,image/webp,image/bmp,image/gif"
    formats={["JPG", "PNG", "WEBP"]}
    icon="🌈"
    title="Drop your image here"
    hint="or click to browse from your device"
  />

  <div id="ext-work" class="hidden space-y-4">
    <div class="preview-stage min-h-[200px]">
      <img id="ext-preview" alt="preview" class="max-h-[300px] max-w-full rounded-lg object-contain" />
    </div>

    <div class="tool-panel">
      <div class="mb-4 flex items-center justify-between">
        <span class="font-bold text-slate-800 dark:text-slate-100">Palette</span>
        <label class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">Colors <input id="ext-count" type="range" min="3" max="12" value="8" class="h-2 w-28 cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 dark:bg-slate-700" /> <span id="ext-count-val" class="text-orange-500">8</span></label>
      </div>
      <div id="ext-palette" class="grid grid-cols-2 gap-2 sm:grid-cols-4"></div>
    </div>
  </div>

  <div slot="rail" class="flex flex-col gap-5">
    <div class="tool-panel">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Color Extractor</h3>
        <span class="local-badge">⚡ Local</span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400">Click any swatch to copy its HEX.</p>
      <button id="ext-reset" type="button" class="btn-premium-ghost mt-4 hidden">Choose another image</button>
    </div>
  </div>

  <script>
    import "../scripts/tools/image-color-extractor";
  </script>
</ToolPage>
