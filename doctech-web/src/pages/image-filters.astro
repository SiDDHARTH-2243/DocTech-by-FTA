---
import ToolPage from "../components/ToolPage.astro";
import PremiumDropzone from "../components/PremiumDropzone.astro";
---

<ToolPage
  title="Image Filters"
  subtitle="Apply brightness, contrast, saturation, blur, sepia and more — or start from a one-click preset. All in your browser."
>
  <PremiumDropzone
    dropId="flt-drop"
    inputId="flt-input"
    accept="image/png,image/jpeg,image/webp,image/bmp"
    formats={["JPG", "PNG", "WEBP"]}
    icon="🎚️"
    title="Drop your image here"
    hint="or click to browse from your device"
  />

  <div id="flt-work" class="hidden space-y-4">
    <div class="preview-stage min-h-[260px]">
      <canvas id="flt-canvas" class="max-h-[420px] max-w-full rounded-lg object-contain"></canvas>
    </div>

    <div id="flt-presets" class="flex flex-wrap gap-2"></div>

    <div class="tool-panel grid gap-5 sm:grid-cols-2">
      {[
        ["flt-brightness", "Brightness", 0, 200, 100, "%"],
        ["flt-contrast", "Contrast", 0, 200, 100, "%"],
        ["flt-saturate", "Saturation", 0, 200, 100, "%"],
        ["flt-grayscale", "Grayscale", 0, 100, 0, "%"],
        ["flt-sepia", "Sepia", 0, 100, 0, "%"],
        ["flt-hue", "Hue rotate", 0, 360, 0, "°"],
        ["flt-blur", "Blur", 0, 20, 0, "px"],
        ["flt-invert", "Invert", 0, 100, 0, "%"],
      ].map(([id, label, min, max, val, unit]) => (
        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">{label}</span>
            <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-400"><span id={`${id}-val`}>{val}</span>{unit}</span>
          </div>
          <input id={id} type="range" min={min} max={max} value={val} class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 outline-none dark:bg-slate-700" />
        </div>
      ))}
    </div>
  </div>

  <div slot="rail" class="flex flex-col gap-5">
    <div class="tool-panel">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Filters</h3>
        <span class="local-badge">⚡ Local</span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400">Tune the sliders or tap a preset above.</p>
    </div>

    <div class="space-y-3">
      <button id="flt-download" type="button" disabled class="btn-premium">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download
      </button>
      <button id="flt-reset-filters" type="button" class="btn-premium-ghost hidden">Reset filters</button>
      <button id="flt-reset" type="button" class="btn-premium-ghost hidden">Choose another image</button>
    </div>
  </div>

  <script>
    import "../scripts/tools/image-filters";
  </script>
</ToolPage>
