---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Add Watermark"
  subtitle="Stamp a diagonal text watermark across every page of your PDF. Processed entirely in your browser."
>
  <label
    id="wm-dropzone"
    for="wm-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">💧</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="wm-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="wm-opts" class="mt-5 hidden flex-col gap-4">
    <p id="wm-info" class="text-sm font-semibold text-indigo-600 dark:text-indigo-400"></p>
    <div>
      <label class="mb-1.5 block text-sm font-semibold" for="wm-text">Watermark text</label>
      <input
        id="wm-text"
        type="text"
        value="CONFIDENTIAL"
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-400 focus:ring-2 focus:ring-orange-200 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:ring-orange-500/30"
      />
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="wm-opacity">
          Opacity <span id="wm-opacity-val" class="text-orange-500">15%</span>
        </label>
        <input id="wm-opacity" type="range" min="5" max="50" value="15" class="w-full accent-orange-500" />
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="wm-color">Color</label>
        <select
          id="wm-color"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
        >
          <option value="gray">Gray</option>
          <option value="red">Red</option>
          <option value="blue">Blue</option>
        </select>
      </div>
    </div>
    <button
      id="wm-btn"
      type="button"
      class="w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600"
    >
      Apply Watermark &amp; Download
    </button>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Watermark</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      <span id="wm-count" class="font-bold text-orange-500">0</span> pages loaded
    </p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      ⚡ Local · no upload
    </span>
  </div>

  <script>
    import "../scripts/tools/watermark";
  </script>
</ToolPage>
