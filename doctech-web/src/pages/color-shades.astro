---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Color Shades Generator"
  subtitle="Get all shades of a color by stepping through lighten, darken, saturate and desaturate. Click any swatch to copy."
>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
    <div class="flex flex-wrap items-end gap-4">
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="sh-picker">Base color</label>
        <input id="sh-picker" type="color" value="#3b82f6" class="h-11 w-14 cursor-pointer rounded-lg border border-slate-300 bg-transparent dark:border-slate-700" />
      </div>
      <div class="flex-1">
        <label class="mb-1.5 block text-sm font-semibold" for="sh-hex">HEX</label>
        <input
          id="sh-hex"
          type="text"
          value="#3b82f6"
          spellcheck="false"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm uppercase focus:border-orange-400 focus:ring-2 focus:ring-orange-200 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:ring-orange-500/30"
        />
      </div>
      <div class="w-40">
        <label class="mb-1.5 block text-sm font-semibold" for="sh-steps">
          Steps <span id="sh-steps-val" class="text-orange-500">6</span>
        </label>
        <input id="sh-steps" type="range" min="1" max="10" value="6" class="w-full accent-orange-500" />
      </div>
    </div>

    <div id="sh-output" class="mt-6 grid gap-5"></div>
  </div>

  <script>
    import "../scripts/tools/color-shades";
  </script>
</CenteredTool>
