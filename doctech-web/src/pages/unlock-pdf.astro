---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Unlock PDF"
  subtitle="Remove password protection from an encrypted PDF. Tried locally first; AES-256 files use the secure server."
>
  <label
    id="ul-dropzone"
    for="ul-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🔓</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop an encrypted PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="ul-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="ul-opts" class="mt-5 hidden">
    <p id="ul-info" class="mb-4 text-sm font-semibold text-indigo-600 dark:text-indigo-400"></p>
    <label class="mb-1.5 block text-sm font-semibold" for="ul-pwd">PDF password</label>
    <input
      id="ul-pwd"
      type="password"
      autocomplete="off"
      placeholder="Enter the password used to lock this PDF"
      class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-400 focus:ring-2 focus:ring-orange-200 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:ring-orange-500/30"
    />
    <button
      id="ul-btn"
      type="button"
      class="mt-4 w-full rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sky-700"
    >
      Unlock &amp; Download
    </button>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Unlock PDF</h2>
    <p id="ul-rail" class="mt-1 text-xs text-slate-500 dark:text-slate-400">No file loaded.</p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-600 dark:bg-sky-500/10 dark:text-sky-400"
    >
      ☁️ Local first · server fallback
    </span>
  </div>

  <script>
    import "../scripts/tools/unlock-pdf";
  </script>
</ToolPage>
