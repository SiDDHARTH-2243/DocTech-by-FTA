---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Split PDF"
  subtitle="Extract a page range into a new PDF, or explode every page into a ZIP archive. Processed entirely in your browser."
>
  <label
    id="split-dropzone"
    for="split-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">✂️</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="split-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="split-opts" class="mt-5 hidden">
    <p id="split-info" class="mb-4 text-sm font-semibold text-indigo-600 dark:text-indigo-400"></p>
    <div
      id="split-preview"
      class="mb-4 flex h-[200px] w-[150px] items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"
    >
    </div>
    <label class="mb-1.5 block text-sm font-semibold" for="split-range">Page range to extract</label>
    <input
      id="split-range"
      type="text"
      placeholder="e.g. 1-3, 5, 8-10 — leave blank to split ALL pages"
      class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-400 focus:ring-2 focus:ring-orange-200 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:ring-orange-500/30"
    />
    <div class="mt-4 flex flex-wrap gap-3">
      <button
        id="split-extract"
        type="button"
        class="flex-1 rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600"
      >
        Extract Range
      </button>
      <button
        id="split-zip"
        type="button"
        class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        All Pages → ZIP
      </button>
    </div>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Split PDF</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      <span id="split-count" class="font-bold text-orange-500">0</span> pages loaded
    </p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      ⚡ Local · no upload
    </span>
    <p class="mt-3 text-[11px] text-slate-400">Load a PDF to choose pages.</p>
  </div>

  <script>
    import "../scripts/tools/split-pdf";
  </script>
</ToolPage>
