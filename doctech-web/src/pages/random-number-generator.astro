---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Random Number Generator"
  subtitle="Draw random numbers in any range — unique or repeatable, sorted or shuffled — with fair crypto-backed randomness."
>
  <div class="space-y-5">
    <div class="tool-panel space-y-5">
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div>
          <label class="field-label" for="rn-min">Minimum</label>
          <input id="rn-min" type="number" value="1" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100" />
        </div>
        <div>
          <label class="field-label" for="rn-max">Maximum</label>
          <input id="rn-max" type="number" value="100" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100" />
        </div>
        <div>
          <label class="field-label" for="rn-count">How many</label>
          <input id="rn-count" type="number" min="1" max="1000" value="6" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100" />
        </div>
      </div>
      <div class="flex flex-wrap items-end gap-4">
        <label class="flex items-center gap-2 text-sm font-medium"><input id="rn-unique" type="checkbox" class="accent-orange-500" /> No repeats</label>
        <div class="w-40">
          <label class="field-label" for="rn-sort">Order</label>
          <select id="rn-sort" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="none">Random</option>
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
          </select>
        </div>
        <button id="rn-generate" type="button" class="btn-premium !w-auto grow">Generate</button>
      </div>
    </div>

    <div class="tool-panel">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Result</h3>
        <button id="rn-copy" type="button" class="btn-premium-ghost !w-auto px-3 py-1.5 text-xs">Copy</button>
      </div>
      <div id="rn-output" class="flex min-h-[80px] flex-wrap gap-2"></div>
    </div>
  </div>

  <script>
    import "../scripts/tools/random-number-generator";
  </script>
</CenteredTool>
