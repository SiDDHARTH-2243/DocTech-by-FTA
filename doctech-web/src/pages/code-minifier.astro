---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="Code Minifier"
  subtitle="Shrink JavaScript, CSS, HTML and JSON — Terser-powered JS mangling plus safe CSS/HTML compression, with a live size-saved readout."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-center gap-4">
        <div>
          <label class="field-label" for="min-lang">Language</label>
          <select id="min-lang" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="js">JavaScript</option>
            <option value="css">CSS</option>
            <option value="html">HTML</option>
            <option value="json">JSON</option>
          </select>
        </div>
        <label id="min-mangle-wrap" class="flex cursor-pointer items-center gap-2 pt-5 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <input type="checkbox" id="min-mangle" class="h-4 w-4 accent-orange-500" checked /> Mangle names (JS)
        </label>

        <div class="ml-auto flex items-center gap-4">
          <div id="min-stats" class="text-right font-mono text-xs text-slate-500 dark:text-slate-400">—</div>
          <button type="button" id="min-run" class="rounded-xl bg-orange-500 px-5 py-2 text-sm font-bold text-white transition-colors hover:bg-orange-600">Minify</button>
        </div>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <CodePane id="min-in" label="Source" placeholder="Paste code to minify…" rows={18} actions={["sample", "upload", "clear"]} counts />
      <CodePane id="min-out" label="Minified" variant="output" language="javascript" rows={18} actions={["copy", "download"]} counts />
    </div>
  </div>

  <script>
    import "../scripts/tools/code-minifier";
  </script>
</CenteredTool>
