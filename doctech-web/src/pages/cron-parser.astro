---
import CenteredTool from "../components/CenteredTool.astro";

const presets = [
  ["Every minute", "* * * * *"],
  ["Every 15 min", "*/15 * * * *"],
  ["Hourly", "0 * * * *"],
  ["Daily 9am", "0 9 * * *"],
  ["Weekdays 9am", "0 9 * * 1-5"],
  ["Midnight Sun", "0 0 * * 0"],
  ["1st of month", "0 0 1 * *"],
  ["Quarterly", "0 0 1 1,4,7,10 *"],
];
---

<CenteredTool
  title="Cron Expression Parser"
  subtitle="Decode any cron schedule into plain English and see its next run times — supports ranges, steps, lists, named months/days and @daily-style aliases."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <label class="field-label" for="cron-in">Cron expression</label>
      <input
        id="cron-in"
        type="text"
        spellcheck="false"
        autocomplete="off"
        placeholder="*/5 9-17 * * 1-5"
        class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-center font-mono text-lg tracking-wide outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"
      />
      <div class="mt-2 grid grid-cols-5 gap-2 text-center">
        {["minute", "hour", "day (month)", "month", "day (week)"].map((f) => (
          <span class="text-[10px] font-bold uppercase tracking-wide text-slate-400">{f}</span>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {presets.map(([label, expr]) => (
          <button type="button" data-cron={expr} class="cron-preset rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:border-orange-400 hover:bg-orange-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-orange-500/10">{label}</button>
        ))}
      </div>
    </div>

    <div id="cron-error" class="hidden rounded-2xl border border-red-300 bg-red-50 px-4 py-3 font-mono text-sm font-semibold text-red-600 dark:border-red-500/40 dark:bg-red-500/10 dark:text-red-300"></div>

    <div id="cron-result" class="hidden space-y-5">
      <div class="tool-panel text-center">
        <span class="field-label">This schedule means</span>
        <p id="cron-desc" class="text-xl font-bold text-slate-800 dark:text-slate-100"></p>
      </div>

      <div class="tool-panel">
        <div class="mb-3 flex items-center justify-between">
          <span class="field-label !mb-0">Next runs</span>
          <span class="text-xs text-slate-400">local time · <code id="cron-tz" class="font-mono"></code></span>
        </div>
        <ol id="cron-next" class="space-y-1.5"></ol>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/cron-parser";
  </script>
</CenteredTool>
