---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="CSS Loader Generator"
  subtitle="Browse 60+ pure-CSS loaders — filter by category or pick from trending picks, then customize and copy the code."
>
  <!-- Trending / Popular banner -->
  <div class="mb-6 rounded-2xl border border-orange-200 bg-gradient-to-r from-orange-50 to-amber-50 p-5 dark:border-orange-500/20 dark:from-orange-500/5 dark:to-amber-500/5">
    <div class="mb-3 flex items-center gap-2">
      <span class="text-lg">🔥</span>
      <span class="text-sm font-bold">Trending & Popular</span>
      <span id="ld-trending-count" class="rounded-full bg-orange-500 px-2 py-0.5 text-[10px] font-bold text-white">0</span>
    </div>
    <div id="ld-trending-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"></div>
  </div>

  <!-- Category tabs + search -->
  <div class="mb-5 flex flex-wrap items-center gap-3">
    <div id="ld-tabs" class="flex flex-wrap gap-2"></div>
    <div class="ml-auto flex items-center gap-2">
      <span id="ld-total" class="text-xs font-semibold text-slate-400"></span>
    </div>
  </div>

  <!-- Loader grid -->
  <div id="ld-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4"></div>

  <!-- Customize / Export modal -->
  <div id="ld-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm">
    <div class="grid max-h-[90vh] w-full max-w-3xl grid-cols-1 overflow-hidden rounded-2xl border border-slate-200 bg-white md:grid-cols-2 dark:border-slate-700 dark:bg-slate-900">
      <!-- Preview side -->
      <div id="ld-modal-canvas" class="flex min-h-[220px] items-center justify-center md:min-h-full">
        <div id="ld-modal-loader"></div>
      </div>

      <!-- Control & export side -->
      <div class="flex max-h-[90vh] flex-col overflow-y-auto p-5">
        <div class="mb-4 flex items-center justify-between">
          <div>
            <h3 id="ld-modal-title" class="text-base font-bold"></h3>
            <span id="ld-modal-cat" class="text-xs font-medium text-slate-400"></span>
          </div>
          <button id="ld-modal-close" type="button" aria-label="Close" class="rounded-lg px-2 py-1 text-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800">✕</button>
        </div>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3">
          <div>
            <label class="mb-1 block text-xs font-semibold" for="ld-size">Size <span id="ld-size-val" class="text-orange-500">48</span>px</label>
            <input id="ld-size" type="range" min="16" max="120" value="48" class="w-full accent-orange-500" />
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold" for="ld-speed">Speed <span id="ld-speed-val" class="text-orange-500">1.2</span>s</label>
            <input id="ld-speed" type="range" min="0.3" max="3" step="0.1" value="1.2" class="w-full accent-orange-500" />
          </div>
          <div>
            <label class="mb-1 block text-xs font-semibold" for="ld-thick">Thickness <span id="ld-thick-val" class="text-orange-500">5</span>px</label>
            <input id="ld-thick" type="range" min="1" max="16" value="5" class="w-full accent-orange-500" />
          </div>
          <div class="flex gap-4">
            <div>
              <label class="mb-1 block text-xs font-semibold" for="ld-color">Color</label>
              <input id="ld-color" type="color" value="#f97316" class="h-8 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700" />
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold" for="ld-bg">Canvas</label>
              <input id="ld-bg" type="color" value="#1e293b" class="h-8 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700" />
            </div>
          </div>
        </div>

        <!-- Quick color presets -->
        <div class="mt-3 flex flex-wrap gap-1.5">
          {
            [
              { c: "#f97316", bg: "#1e293b" },
              { c: "#3b82f6", bg: "#0f172a" },
              { c: "#10b981", bg: "#0f172a" },
              { c: "#ef4444", bg: "#1e293b" },
              { c: "#a855f7", bg: "#0f172a" },
              { c: "#ffffff", bg: "#1e293b" },
              { c: "#22d3ee", bg: "#0f172a" },
              { c: "#f43f5e", bg: "#ffffff" },
              { c: "#0f172a", bg: "#f8fafc" },
            ].map(({ c, bg }) => (
              <button
                type="button"
                data-qcolor={c}
                data-qbg={bg}
                class="h-6 w-6 rounded-full border-2 border-transparent transition-all hover:scale-110 hover:border-slate-400"
                style={`background:${c};box-shadow:inset 0 -3px 0 ${bg}`}
                title={`${c} on ${bg}`}
              ></button>
            ))
          }
        </div>

        <!-- Code blocks -->
        <div class="mt-4 space-y-3">
          <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-3 py-1.5 dark:border-slate-700 dark:bg-slate-800">
              <span class="text-[11px] font-semibold tracking-wide text-slate-400 uppercase">HTML</span>
              <button id="ld-html-copy" type="button" class="rounded bg-orange-500 px-2 py-0.5 text-[11px] font-semibold text-white hover:bg-orange-600">Copy</button>
            </div>
            <pre id="ld-html" class="overflow-x-auto px-3 py-2 font-mono text-xs dark:text-slate-100"></pre>
          </div>
          <div class="overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-3 py-1.5 dark:border-slate-700 dark:bg-slate-800">
              <span class="text-[11px] font-semibold tracking-wide text-slate-400 uppercase">CSS</span>
              <button id="ld-css-copy" type="button" class="rounded bg-orange-500 px-2 py-0.5 text-[11px] font-semibold text-white hover:bg-orange-600">Copy</button>
            </div>
            <pre id="ld-css" class="max-h-40 overflow-auto px-3 py-2 font-mono text-xs dark:text-slate-100"></pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/css-loader-generator";
  </script>
</CenteredTool>
