---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Regex Tester"
  subtitle="Test JavaScript regular expressions live — highlighted matches, capture groups, named groups and a replacement preview, with a built-in cheat sheet."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <label class="field-label" for="re-pattern">Pattern</label>
      <div class="flex items-stretch overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition-all focus-within:border-orange-500 focus-within:ring-4 focus-within:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60">
        <span class="flex items-center px-3 font-mono text-lg text-slate-400">/</span>
        <input
          id="re-pattern"
          type="text"
          spellcheck="false"
          placeholder="\b\w+@\w+\.\w{2,}\b"
          class="min-w-0 flex-1 bg-transparent py-3 font-mono text-sm text-slate-800 outline-none placeholder:text-slate-400 dark:text-slate-100"
        />
        <span class="flex items-center px-3 font-mono text-lg text-slate-400">/</span>
        <span id="re-flagview" class="flex items-center pr-3 font-mono text-sm font-bold text-orange-500">g</span>
      </div>

      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {[
          ["g", "global — find all matches"],
          ["i", "ignore case"],
          ["m", "multiline ^ $"],
          ["s", "dotall — . matches newline"],
          ["u", "unicode"],
          ["y", "sticky"],
        ].map(([f, desc]) => (
          <label class="flex cursor-pointer items-center gap-1.5 text-sm text-slate-600 dark:text-slate-300" title={desc}>
            <input type="checkbox" class="re-flag h-4 w-4 accent-orange-500" data-flag={f} checked={f === "g"} />
            <code class="font-mono font-bold">{f}</code>
          </label>
        ))}
      </div>

      <p id="re-error" class="mt-3 hidden rounded-lg bg-red-50 px-3 py-2 font-mono text-xs font-semibold text-red-600 dark:bg-red-500/10 dark:text-red-300"></p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <div class="tool-panel">
        <div class="mb-2 flex items-center justify-between">
          <label class="field-label !mb-0" for="re-test">Test string</label>
          <button type="button" id="re-sample" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Sample</button>
        </div>
        <textarea
          id="re-test"
          rows="10"
          spellcheck="false"
          placeholder="Paste the text to search…"
          class="w-full resize-y rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-xs leading-6 outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"
        ></textarea>
      </div>

      <div class="tool-panel">
        <div class="mb-2 flex items-center justify-between">
          <span class="field-label !mb-0">Highlighted matches</span>
          <span id="re-count" class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">0 matches</span>
        </div>
        <div id="re-highlight" class="h-[15.5rem] overflow-auto whitespace-pre-wrap break-words rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-xs leading-6 dark:border-slate-700 dark:bg-slate-900/60"></div>
      </div>
    </div>

    <div class="tool-panel">
      <label class="field-label" for="re-replace">Replacement preview</label>
      <input
        id="re-replace"
        type="text"
        spellcheck="false"
        placeholder="$1 — use $1, $2 for groups, $<name> for named groups"
        class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 font-mono text-sm outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"
      />
      <div id="re-replaced" class="mt-3 max-h-40 overflow-auto whitespace-pre-wrap break-words rounded-2xl bg-slate-50 px-3 py-3 font-mono text-xs leading-6 text-slate-700 dark:bg-slate-800/50 dark:text-slate-200"></div>
    </div>

    <div class="tool-panel">
      <span class="field-label">Matches</span>
      <div id="re-matches" class="max-h-80 space-y-2 overflow-auto"></div>
    </div>

    <details class="tool-panel">
      <summary class="cursor-pointer text-sm font-bold text-slate-700 dark:text-slate-200">Cheat sheet</summary>
      <div class="mt-4 grid gap-x-8 gap-y-1.5 sm:grid-cols-2">
        {[
          ["\\d", "any digit"], ["\\w", "word character"], ["\\s", "whitespace"],
          ["\\b", "word boundary"], [".", "any character"], ["^ $", "start / end"],
          ["*", "0 or more"], ["+", "1 or more"], ["?", "0 or 1 (or lazy)"],
          ["{2,5}", "between 2 and 5"], ["[abc]", "any of a, b, c"], ["[^abc]", "none of a, b, c"],
          ["(…)", "capture group"], ["(?:…)", "non-capturing group"], ["(?<name>…)", "named group"],
          ["a|b", "a or b"], ["(?=…)", "lookahead"], ["(?<=…)", "lookbehind"],
        ].map(([token, meaning]) => (
          <div class="flex items-baseline gap-3 text-sm">
            <code class="min-w-[5.5rem] font-mono font-bold text-orange-600 dark:text-orange-400">{token}</code>
            <span class="text-slate-500 dark:text-slate-400">{meaning}</span>
          </div>
        ))}
      </div>
    </details>
  </div>

  <script>
    import "../scripts/tools/regex-tester";
  </script>
</CenteredTool>
