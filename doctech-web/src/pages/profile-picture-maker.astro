---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Profile Picture Maker"
  subtitle="Crop any photo into a clean circular profile picture with a custom ring and background — then download it (transparent PNG supported)."
>
  <label
    id="pfp-drop"
    for="pfp-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🟣</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Drag &amp; drop a photo, or click to browse</span>
    <span class="text-xs text-slate-400">JPG · PNG · WebP</span>
    <input id="pfp-input" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
  </label>

  <div id="pfp-work" class="hidden space-y-4">
    <div class="flex min-h-[300px] items-center justify-center overflow-auto rounded-2xl border border-slate-200 bg-[repeating-conic-gradient(#e2e8f0_0_25%,transparent_0_50%)] bg-[length:20px_20px] p-4 dark:border-slate-700">
      <canvas id="pfp-canvas" class="max-h-[420px] max-w-full"></canvas>
    </div>
    <div class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-2 dark:border-slate-800 dark:bg-slate-900">
      <label class="block text-sm"><span class="mb-1 block font-semibold">Zoom <span id="pfp-zoom-val" class="text-orange-500">1.0</span>×</span><input id="pfp-zoom" type="range" min="1" max="3" step="0.05" value="1" class="w-full accent-orange-500" /></label>
      <label class="block text-sm"><span class="mb-1 block font-semibold">Ring width <span id="pfp-ringw-val" class="text-orange-500">0</span></span><input id="pfp-ringw" type="range" min="0" max="40" value="0" class="w-full accent-orange-500" /></label>
      <label class="flex items-center gap-2 text-sm"><span class="font-semibold">Ring colour</span><input id="pfp-ring" type="color" value="#f97316" class="h-8 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700" /></label>
      <label class="flex items-center gap-2 text-sm"><span class="font-semibold">Background</span><input id="pfp-bg" type="color" value="#ffffff" class="h-8 w-12 cursor-pointer rounded border border-slate-300 bg-transparent dark:border-slate-700" /><label class="ml-2 flex items-center gap-1 text-xs"><input id="pfp-transparent" type="checkbox" class="h-4 w-4 accent-orange-500" /> transparent</label></label>
    </div>
  </div>

  <div slot="rail" class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-sm font-semibold">Profile Picture</h2>
    <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">⚡ Local · no upload</span>
    <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Outputs a 800×800 PNG.</p>
    <button id="pfp-download" type="button" disabled class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 dark:disabled:bg-slate-800 dark:disabled:text-slate-600">Download PNG</button>
    <button id="pfp-reset" type="button" class="mt-2 hidden w-full rounded-xl border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">Choose another photo</button>
  </div>

  <script>
    import "../scripts/tools/profile-picture-maker";
  </script>
</ToolPage>
