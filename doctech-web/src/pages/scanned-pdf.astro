---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Scanned PDF Converter"
  subtitle="Turn a clean, digital PDF into one that looks photocopied or scanned — paper tint, grain, a slight skew and contrast. Runs entirely in your browser."
>
  <label
    id="scan-dropzone"
    for="scan-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🖨️</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="scan-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="scan-opts" class="mt-5 hidden">
    <p id="scan-info" class="mb-4 text-sm font-semibold text-indigo-600 dark:text-indigo-400"></p>
    <div
      id="scan-preview"
      class="mb-4 flex h-[200px] w-[150px] items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"
    >
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="scan-intensity">Scan look</label>
        <select
          id="scan-intensity"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
        >
          <option value="light">Light — subtle</option>
          <option value="medium" selected>Medium — recommended</option>
          <option value="heavy">Heavy — old photocopy</option>
        </select>
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="scan-scale">Resolution scale</label>
        <select
          id="scan-scale"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
        >
          <option value="1.5">1.5× (faster)</option>
          <option value="2" selected>2× (recommended)</option>
          <option value="3">3× (high quality)</option>
        </select>
      </div>
    </div>
    <label class="mt-4 flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200">
      <input id="scan-gray" type="checkbox" class="h-4 w-4 accent-orange-500" />
      Grayscale (black-and-white scan)
    </label>
    <button
      id="scan-btn"
      type="button"
      class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600"
    >
      Convert &amp; Download
    </button>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Scanned PDF Converter</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      <span id="scan-count" class="font-bold text-orange-500">0</span> pages loaded
    </p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      ⚡ Local · no upload
    </span>
  </div>

  <script>
    import "../scripts/tools/scanned-pdf";
  </script>
</ToolPage>
