---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="HTML Entity Encoder & Decoder"
  subtitle="Escape text for safe use in HTML, or turn entities back into readable characters — named, decimal and hex entities all supported."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex rounded-xl border border-slate-200 p-1 dark:border-slate-700">
          <button type="button" data-mode="encode" class="ent-mode rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="true">Encode</button>
          <button type="button" data-mode="decode" class="ent-mode rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="false">Decode</button>
        </div>

        <div id="ent-levelwrap">
          <select id="ent-level" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="minimal">Minimal — only &amp; &lt; &gt; " '</option>
            <option value="named" selected>Named — use &amp;copy; etc. where they exist</option>
            <option value="all">All non-ASCII — numeric fallback for everything</option>
          </select>
        </div>

        <button type="button" id="ent-swap" class="ml-auto rounded-xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">⇅ Swap</button>
      </div>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        <strong>Minimal</strong> is what you want for escaping user content into a page — it neutralises the
        characters that can break out of markup and nothing else.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <CodePane id="ent-in" label="Input" placeholder={'<p class="hi">Tom & Jerry — 50% off!</p>'} rows={12} actions={["sample", "clear"]} counts />
      <CodePane id="ent-out" label="Output" variant="output" rows={12} actions={["copy", "download"]} counts />
    </div>

    <div class="tool-panel">
      <span class="field-label">Rendered preview</span>
      <p class="mb-3 text-xs text-slate-500 dark:text-slate-400">
        How a browser reads the <em>output</em> as text — a quick way to confirm your escaping is correct.
      </p>
      <div id="ent-preview" class="min-h-12 rounded-2xl bg-slate-50 px-3 py-3 text-sm break-words text-slate-700 dark:bg-slate-800/50 dark:text-slate-200"></div>
    </div>

    <details class="tool-panel">
      <summary class="cursor-pointer text-sm font-bold text-slate-700 dark:text-slate-200">Common entities reference</summary>
      <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["&", "&amp;", "ampersand"], ["<", "&lt;", "less than"], [">", "&gt;", "greater than"],
          ['"', "&quot;", "double quote"], ["'", "&apos;", "apostrophe"], [" ", "&nbsp;", "non-breaking space"],
          ["©", "&copy;", "copyright"], ["®", "&reg;", "registered"], ["™", "&trade;", "trademark"],
          ["€", "&euro;", "euro"], ["£", "&pound;", "pound"], ["¥", "&yen;", "yen"],
          ["–", "&ndash;", "en dash"], ["—", "&mdash;", "em dash"], ["…", "&hellip;", "ellipsis"],
          ["“", "&ldquo;", "left double quote"], ["”", "&rdquo;", "right double quote"], ["•", "&bull;", "bullet"],
          ["×", "&times;", "multiply"], ["÷", "&divide;", "divide"], ["°", "&deg;", "degree"],
          ["→", "&rarr;", "right arrow"], ["←", "&larr;", "left arrow"], ["½", "&frac12;", "one half"],
        ].map(([char, entity, name]) => (
          <button
            type="button"
            data-entity={entity}
            data-char={char}
            class="ent-ref flex items-center gap-3 rounded-xl border border-slate-200 px-3 py-2 text-left transition-colors hover:border-orange-400 hover:bg-orange-50 dark:border-slate-700 dark:hover:bg-orange-500/10"
          >
            <span class="w-6 shrink-0 text-center text-base text-slate-800 dark:text-slate-100">{char}</span>
            <code class="shrink-0 font-mono text-xs font-bold text-orange-600 dark:text-orange-400">{entity}</code>
            <span class="truncate text-xs text-slate-500 dark:text-slate-400">{name}</span>
          </button>
        ))}
      </div>
    </details>
  </div>

  <script>
    import "../scripts/tools/html-entity-encoder";
  </script>
</CenteredTool>
