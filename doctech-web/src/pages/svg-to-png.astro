---
import ToolPage from "../components/ToolPage.astro";
import PremiumDropzone from "../components/PremiumDropzone.astro";
---

<ToolPage
  title="SVG to PNG Converter"
  subtitle="Rasterize any SVG into a crisp PNG at the scale you choose — upload a file or paste the markup. Fully in-browser."
>
  <PremiumDropzone
    dropId="svp-drop"
    inputId="svp-input"
    accept="image/svg+xml,.svg"
    formats={["SVG"]}
    icon="🖼️"
    title="Drop your SVG here"
    hint="or click to browse from your device"
  />

  <div class="my-3 text-center text-xs font-semibold text-slate-400">— or paste SVG code —</div>
  <textarea id="svp-paste" rows="4" placeholder="<svg …>…</svg>" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 font-mono text-xs outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"></textarea>

  <div id="svp-work" class="mt-4 hidden space-y-4">
    <div class="preview-stage min-h-[240px]">
      <canvas id="svp-canvas" class="max-h-[420px] max-w-full rounded-lg"></canvas>
    </div>
    <div class="tool-panel">
      <div class="mb-2 flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Scale</span>
        <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-400"><span id="svp-scale-val">2</span>×</span>
      </div>
      <input id="svp-scale" type="range" min="1" max="6" step="0.5" value="2" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 outline-none dark:bg-slate-700" />
    </div>
  </div>

  <div slot="rail" class="flex flex-col gap-5">
    <div class="tool-panel">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">SVG → PNG</h3>
        <span class="local-badge">⚡ Local</span>
      </div>
      <dl class="space-y-3 text-sm">
        <div class="flex items-center justify-between"><dt class="text-slate-500 dark:text-slate-400">PNG size</dt><dd id="svp-dims" class="font-mono font-semibold text-orange-500">—</dd></div>
      </dl>
    </div>

    <button id="svp-download" type="button" disabled class="btn-premium">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
      Download PNG
    </button>
  </div>

  <script>
    import "../scripts/tools/svg-to-png";
  </script>
</ToolPage>
