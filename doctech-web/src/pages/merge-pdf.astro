---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Merge PDF"
  subtitle="Add multiple PDFs — they merge in the order shown. Drag a row (or use ↑ ↓) to reorder. Processed entirely in your browser."
>
  <!-- Drop zone (hidden once files are added) -->
  <label
    id="merge-dropzone"
    for="merge-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🧩</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop PDFs here, or click to browse
    </span>
    <span class="text-xs text-slate-400">You can select multiple files</span>
    <input id="merge-input" type="file" accept="application/pdf,.pdf" multiple class="hidden" />
  </label>

  <!-- Add-more affordance (shown after the first file) -->
  <label
    id="merge-addmore"
    for="merge-input"
    class="mt-1 hidden cursor-pointer items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 px-4 py-3 text-sm font-semibold text-slate-500 transition-colors hover:border-orange-400 hover:text-orange-600 dark:border-slate-700 dark:text-slate-400"
  >
    <span class="text-lg leading-none">＋</span> Add more PDFs
  </label>

  <!-- File list -->
  <ul id="merge-list" class="mt-4 flex flex-col gap-2"></ul>
  <p id="merge-empty" class="mt-4 text-center text-sm text-slate-400">No files added yet.</p>
  <p id="merge-status" class="mt-3 text-sm text-slate-500 dark:text-slate-400"></p>

  <!-- Right rail -->
  <div slot="rail" class="flex flex-col gap-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-sm font-semibold">Merge PDFs</h2>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
        <span id="merge-count" class="font-bold text-orange-500">0</span> PDF(s) ·
        <span id="merge-size" class="font-semibold">0 B</span> combined
      </p>
      <span class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">
        ⚡ Local · no upload
      </span>
      <button
        id="merge-btn"
        type="button"
        disabled
        class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 dark:disabled:bg-slate-800 dark:disabled:text-slate-600"
      >
        Merge PDF Now
      </button>
      <p class="mt-2 text-[11px] text-slate-400">Add at least 2 PDFs to enable.</p>
    </div>

    <!-- Next step (revealed after a successful merge) -->
    <div id="merge-next" class="hidden rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <h3 class="text-sm font-semibold">Next step</h3>
      <div class="mt-3 flex flex-col gap-2">
        <a href="/compress-pdf" class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium transition-colors hover:border-orange-400 hover:text-orange-600 dark:border-slate-700 dark:text-slate-200">
          <span>🗜️</span> Compress the result
        </a>
        <a href="/split-pdf" class="flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium transition-colors hover:border-orange-400 hover:text-orange-600 dark:border-slate-700 dark:text-slate-200">
          <span>✂️</span> Split a PDF
        </a>
      </div>
    </div>
  </div>

  <!-- Full-page drop overlay -->
  <div id="merge-overlay" class="pointer-events-none fixed inset-0 z-[80] hidden items-center justify-center bg-orange-500/10 backdrop-blur-sm">
    <div class="rounded-2xl border-2 border-dashed border-orange-400 bg-white/90 px-8 py-6 text-lg font-bold text-orange-600 dark:bg-slate-900/90 dark:text-orange-400">
      Drop PDFs to add
    </div>
  </div>

  <script>
    import "../scripts/tools/merge-pdf";
  </script>
</ToolPage>
