---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="PDF → Image"
  subtitle="Extract every page from a PDF as a JPG or PNG. Single pages download directly; multi-page PDFs are zipped. Processed entirely in your browser."
>
  <label
    id="p2i-dropzone"
    for="p2i-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">📸</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="p2i-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="p2i-opts" class="mt-5 hidden">
    <p id="p2i-info" class="mb-4 text-sm font-semibold text-indigo-600 dark:text-indigo-400"></p>
    <div
      id="p2i-preview"
      class="mb-4 flex h-[200px] w-[150px] items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"
    >
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="p2i-scale">Resolution scale</label>
        <select
          id="p2i-scale"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
        >
          <option value="1">1× (72 dpi — fast)</option>
          <option value="2" selected>2× (144 dpi — recommended)</option>
          <option value="3">3× (216 dpi — high quality)</option>
          <option value="4">4× (288 dpi — ultra)</option>
        </select>
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-semibold" for="p2i-fmt">Image format</label>
        <select
          id="p2i-fmt"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
        >
          <option value="image/jpeg" selected>JPG (smaller file)</option>
          <option value="image/png">PNG (lossless)</option>
        </select>
      </div>
    </div>
    <button
      id="p2i-btn"
      type="button"
      class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600"
    >
      Convert &amp; Download
    </button>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">PDF → Image</h2>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      <span id="p2i-count" class="font-bold text-orange-500">0</span> pages loaded
    </p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
    >
      ⚡ Local · no upload
    </span>
  </div>

  <script>
    import "../scripts/tools/pdf-to-image";
  </script>
</ToolPage>
