---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="URL Encoder & Decoder"
  subtitle="Percent-encode or decode URLs and query strings, and break any URL apart into its protocol, host, path and parameters."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex rounded-xl border border-slate-200 p-1 dark:border-slate-700">
          <button type="button" data-mode="encode" class="url-mode rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="true">Encode</button>
          <button type="button" data-mode="decode" class="url-mode rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="false">Decode</button>
        </div>

        <div>
          <select id="url-scope" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="component" selected>Component — encode / : ? &amp; = too</option>
            <option value="uri">Full URI — keep the structure intact</option>
          </select>
        </div>

        <button type="button" id="url-swap" class="ml-auto rounded-xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">⇅ Swap</button>
      </div>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        Use <strong>Component</strong> for a value you're putting inside a query string;
        <strong>Full URI</strong> when encoding a whole address you don't want mangled.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <CodePane id="url-in" label="Input" placeholder="https://example.com/search?q=hello world" rows={10} actions={["sample", "clear"]} counts />
      <CodePane id="url-out" label="Output" variant="output" rows={10} actions={["copy", "download"]} counts />
    </div>

    <div class="tool-panel">
      <span class="field-label">URL inspector</span>
      <p id="url-inspect-empty" class="text-sm text-slate-500 dark:text-slate-400">
        Paste a complete URL above to see it broken down here.
      </p>
      <div id="url-inspect" class="hidden space-y-4">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
          {[
            ["Protocol", "url-p-protocol"],
            ["Host", "url-p-host"],
            ["Port", "url-p-port"],
            ["Path", "url-p-path"],
            ["Fragment", "url-p-hash"],
          ].map(([label, id]) => (
            <div class="min-w-0 rounded-xl bg-slate-50 px-3 py-2.5 dark:bg-slate-800/50">
              <div class="text-[11px] font-bold uppercase tracking-wide text-slate-400">{label}</div>
              <div id={id} class="truncate font-mono text-sm font-semibold text-slate-700 dark:text-slate-100">—</div>
            </div>
          ))}
        </div>
        <div id="url-params-wrap" class="hidden">
          <div class="mb-2 text-[11px] font-bold uppercase tracking-wide text-slate-400">Query parameters</div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-[11px] uppercase tracking-wide text-slate-400 dark:border-slate-700">
                  <th class="pb-2 pr-4 font-bold">Key</th>
                  <th class="pb-2 font-bold">Value (decoded)</th>
                </tr>
              </thead>
              <tbody id="url-params"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/url-encoder";
  </script>
</CenteredTool>
