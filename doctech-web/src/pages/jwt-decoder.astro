---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="JWT Decoder"
  subtitle="Decode a JSON Web Token's header and payload, with human-readable timestamps and expiry status. The token never leaves your browser."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <label class="field-label" for="jwt-input">Token</label>
      <textarea
        id="jwt-input"
        rows="4"
        spellcheck="false"
        placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.signature"
        class="w-full resize-y rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-xs leading-5 break-all outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"
      ></textarea>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button" id="jwt-sample" class="rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Load sample</button>
        <button type="button" id="jwt-clear" class="rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Clear</button>
        <span id="jwt-error" class="hidden rounded-lg bg-red-50 px-2.5 py-1 font-mono text-[11px] font-semibold text-red-600 dark:bg-red-500/10 dark:text-red-300"></span>
      </div>

      {/* Colour-coded segments make the three dot-separated parts obvious. */}
      <div id="jwt-segments" class="mt-4 hidden break-all rounded-2xl border border-slate-200 bg-slate-50 p-3 font-mono text-xs leading-6 dark:border-slate-700 dark:bg-slate-900/60">
        <span id="jwt-seg-h" class="text-red-600 dark:text-red-400"></span><span class="text-slate-400">.</span><span id="jwt-seg-p" class="text-violet-600 dark:text-violet-400"></span><span class="text-slate-400">.</span><span id="jwt-seg-s" class="text-sky-600 dark:text-sky-400"></span>
      </div>
    </div>

    <div id="jwt-result" class="hidden space-y-5">
      <div class="rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/40 dark:bg-amber-500/10 dark:text-amber-200">
        <strong>Decoded, not verified.</strong> Anyone can read a JWT's contents — the signature is what proves
        it's genuine, and checking it needs the secret or public key. Never trust these claims without
        verifying server-side.
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        <CodePane id="jwt-header" label="Header" variant="output" language="json" rows={10} actions={["copy"]} counts={false} />
        <CodePane id="jwt-payload" label="Payload" variant="output" language="json" rows={10} actions={["copy"]} counts={false} />
      </div>

      <div class="tool-panel">
        <span class="field-label">Registered claims</span>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-[11px] uppercase tracking-wide text-slate-400 dark:border-slate-700">
                <th class="pb-2 pr-4 font-bold">Claim</th>
                <th class="pb-2 pr-4 font-bold">Meaning</th>
                <th class="pb-2 font-bold">Value</th>
              </tr>
            </thead>
            <tbody id="jwt-claims"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/jwt-decoder";
  </script>
</CenteredTool>
