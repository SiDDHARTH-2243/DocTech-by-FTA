---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Unix Timestamp Converter"
  subtitle="Convert Unix epoch timestamps to human dates and back — seconds or milliseconds auto-detected, with local and UTC output plus a live clock."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="field-label">Epoch right now</span>
          <div class="flex items-baseline gap-3">
            <code id="ts-now" class="font-mono text-3xl font-extrabold tracking-tight text-slate-800 dark:text-slate-100">—</code>
            <button type="button" id="ts-now-copy" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Copy</button>
          </div>
          <p id="ts-now-local" class="mt-1 text-sm text-slate-500 dark:text-slate-400">—</p>
        </div>
        <button type="button" id="ts-use-now" class="rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-orange-600">Use current time</button>
      </div>
    </div>

    <div class="tool-panel">
      <label class="field-label" for="ts-epoch">Timestamp → date</label>
      <div class="flex flex-wrap gap-3">
        <input
          id="ts-epoch"
          type="text"
          inputmode="numeric"
          spellcheck="false"
          placeholder="1700000000"
          class="min-w-0 flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 font-mono text-sm outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"
        />
        <select id="ts-unit" class="rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
          <option value="auto" selected>Auto-detect</option>
          <option value="s">Seconds</option>
          <option value="ms">Milliseconds</option>
        </select>
      </div>
      <p id="ts-epoch-note" class="mt-2 text-xs text-slate-500 dark:text-slate-400"></p>
    </div>

    <div class="tool-panel">
      <label class="field-label" for="ts-date">Date → timestamp</label>
      <div class="flex flex-wrap gap-3">
        <input
          id="ts-date"
          type="datetime-local"
          step="1"
          class="min-w-0 flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 font-mono text-sm outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"
        />
        <select id="ts-date-zone" class="rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
          <option value="local" selected>Local time</option>
          <option value="utc">UTC</option>
        </select>
      </div>
    </div>

    <div class="tool-panel">
      <span class="field-label">Converted</span>
      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        {[
          ["Unix seconds", "ts-o-s"],
          ["Unix milliseconds", "ts-o-ms"],
          ["ISO 8601 (local)", "ts-o-isolocal"],
          ["ISO 8601 (UTC)", "ts-o-isoutc"],
          ["RFC 2822", "ts-o-rfc"],
          ["Local, long form", "ts-o-human"],
          ["UTC, long form", "ts-o-humanutc"],
          ["Relative", "ts-o-rel"],
          ["Day of year / week", "ts-o-doy"],
        ].map(([label, id]) => (
          <div class="flex items-center gap-3 py-2.5">
            <span class="w-40 shrink-0 text-xs font-bold uppercase tracking-wide text-slate-400">{label}</span>
            <code id={id} class="min-w-0 flex-1 truncate font-mono text-sm text-slate-700 dark:text-slate-200">—</code>
            <button type="button" data-tscopy={id} class="shrink-0 rounded-lg border border-slate-200 px-2 py-0.5 text-[11px] font-semibold text-slate-500 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-400 dark:hover:bg-slate-800">Copy</button>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
        Your timezone: <code id="ts-tz" class="font-mono font-semibold"></code>
      </p>
    </div>
  </div>

  <script>
    import "../scripts/tools/timestamp-converter";
  </script>
</CenteredTool>
