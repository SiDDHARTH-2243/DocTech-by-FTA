---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Barcode Generator"
  subtitle="Generate CODE128, EAN, UPC, CODE39 and ITF barcodes from any value, then download them as crisp PNG or SVG."
>
  <div class="lg:grid lg:grid-cols-[1fr_minmax(0,360px)] lg:items-start lg:gap-6">
    <!-- Preview -->
    <div class="lg:sticky lg:top-4">
      <div class="preview-stage min-h-[300px] p-6">
        <svg id="bc-svg" class="max-h-[360px] max-w-full"></svg>
      </div>
      <p id="bc-error" class="mt-3 hidden text-center text-sm font-semibold text-red-500"></p>
    </div>

    <!-- Controls -->
    <div class="mt-5 space-y-5 lg:mt-0">
      <div class="tool-panel space-y-5">
        <div>
          <label class="field-label" for="bc-value">Value</label>
          <input id="bc-value" type="text" value="DOCTECH-2026" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100" />
        </div>
        <div>
          <label class="field-label" for="bc-format">Format</label>
          <select id="bc-format" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="CODE128" selected>CODE128 (any text)</option>
            <option value="EAN13">EAN-13 (12–13 digits)</option>
            <option value="EAN8">EAN-8 (7–8 digits)</option>
            <option value="UPC">UPC-A (11–12 digits)</option>
            <option value="CODE39">CODE39</option>
            <option value="ITF14">ITF-14 (14 digits)</option>
            <option value="MSI">MSI</option>
            <option value="pharmacode">Pharmacode</option>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <div class="mb-2 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Bar width</span>
              <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-400"><span id="bc-width-val">2</span></span>
            </div>
            <input id="bc-width" type="range" min="1" max="5" step="0.5" value="2" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 outline-none dark:bg-slate-700" />
          </div>
          <div>
            <div class="mb-2 flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Height</span>
              <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-400"><span id="bc-height-val">80</span></span>
            </div>
            <input id="bc-height" type="range" min="30" max="160" step="10" value="80" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-slate-200 accent-orange-500 outline-none dark:bg-slate-700" />
          </div>
        </div>
        <label class="flex items-center gap-2 text-sm font-medium"><input id="bc-text" type="checkbox" checked class="accent-orange-500" /> Show value under bars</label>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <button id="bc-png" type="button" class="btn-premium">Download PNG</button>
        <button id="bc-svg-dl" type="button" class="btn-premium-ghost">Download SVG</button>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/barcode-generator";
  </script>
</CenteredTool>
