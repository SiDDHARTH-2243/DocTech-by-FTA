---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Instagram Filters"
  subtitle="Apply Instagram-style filters to your photos — pick a look, then download. Everything happens in your browser."
>
  <label
    id="igf-drop"
    for="igf-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center transition-colors hover:border-orange-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">📸</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Drag &amp; drop a photo, or click to browse</span>
    <span class="text-xs text-slate-400">JPG · PNG · WebP</span>
    <input id="igf-input" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
  </label>

  <div id="igf-work" class="hidden space-y-4">
    <div class="flex min-h-[280px] items-center justify-center overflow-auto rounded-2xl border border-slate-200 bg-slate-100 p-3 dark:border-slate-700 dark:bg-slate-950">
      <canvas id="igf-canvas" class="max-h-[460px] max-w-full rounded-lg"></canvas>
    </div>
    <div id="igf-strip" class="grid grid-cols-4 gap-2 sm:grid-cols-6"></div>
  </div>

  <div slot="rail" class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-sm font-semibold">Instagram Filters</h2>
    <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">⚡ Local · no upload</span>
    <dl class="mt-4 space-y-2 text-sm">
      <div class="flex justify-between"><dt class="text-slate-500 dark:text-slate-400">Filter</dt><dd id="igf-current" class="font-semibold text-orange-500">Normal</dd></div>
    </dl>
    <button id="igf-download" type="button" disabled class="mt-4 w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400 dark:disabled:bg-slate-800 dark:disabled:text-slate-600">Download</button>
    <button id="igf-reset" type="button" class="mt-2 hidden w-full rounded-xl border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">Choose another photo</button>
  </div>

  <script>
    import "../scripts/tools/instagram-filters";
  </script>
</ToolPage>
