---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Tweet Generator"
  subtitle="Make a realistic-looking tweet — avatar, verified tick, likes and reposts — and download it as an image. For mockups and fun."
>
  <div class="lg:grid lg:grid-cols-[1fr_minmax(0,360px)] lg:items-start lg:gap-6">
    <div class="lg:sticky lg:top-4">
      <div class="flex justify-center overflow-auto rounded-2xl border border-slate-200 bg-slate-100 p-4 dark:border-slate-700 dark:bg-slate-950">
        <canvas id="tg-canvas" class="max-h-[480px] max-w-full rounded-xl shadow"></canvas>
      </div>
    </div>
    <div class="mt-5 space-y-4 lg:mt-0">
      <textarea id="tg-text" rows="3" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">This tool is unreasonably fun to use 😅</textarea>
      <div class="grid grid-cols-2 gap-3 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Name</span><input id="tg-name" type="text" value="Jamie Rivera" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">@handle</span><input id="tg-handle" type="text" value="jamieldn" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Theme</span><select id="tg-theme" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"><option value="light">Light</option><option value="dim">Dim</option><option value="dark">Dark</option></select></label>
        <label class="flex items-center gap-2 pt-5 text-sm"><input id="tg-verified" type="checkbox" checked class="h-4 w-4 accent-sky-500" /> Verified</label>
        <label class="col-span-2 block text-sm"><span class="mb-1 block text-xs font-semibold">Avatar (optional)</span><input id="tg-avatar" type="file" accept="image/*" class="w-full text-xs text-slate-500 file:mr-2 file:rounded-md file:border-0 file:bg-slate-200 file:px-2 file:py-1 file:text-xs dark:text-slate-400 dark:file:bg-slate-700" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Replies</span><input id="tg-replies" type="number" min="0" value="128" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Reposts</span><input id="tg-reposts" type="number" min="0" value="1900" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
        <label class="block text-sm"><span class="mb-1 block text-xs font-semibold">Likes</span><input id="tg-likes" type="number" min="0" value="24300" class="w-full rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" /></label>
      </div>
      <button id="tg-download" type="button" class="w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600">Download PNG</button>
    </div>
  </div>

  <script>
    import "../scripts/tools/tweet-generator";
  </script>
</CenteredTool>
