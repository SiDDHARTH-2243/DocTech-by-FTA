---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Compress PDF"
  subtitle="Reduce PDF file size using the cloud compression engine. Upload a PDF and download the optimized result."
>
  <label
    id="cmp-dropzone"
    for="cmp-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-sky-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">🗜️</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a PDF here, or click to browse
    </span>
    <span class="text-xs text-slate-400">Single PDF file</span>
    <input id="cmp-input" type="file" accept="application/pdf,.pdf" class="hidden" />
  </label>

  <div id="cmp-opts" class="mt-5 hidden">
    <p id="cmp-info" class="mb-4 text-sm font-semibold text-sky-700 dark:text-sky-400"></p>
    <div
      id="cmp-preview"
      class="mb-4 flex h-[200px] w-[150px] items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"
    >
    </div>
    <label class="mb-1.5 block text-sm font-semibold" for="cmp-level">Compression level</label>
    <select
      id="cmp-level"
      class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100"
    >
      <option value="low">🔥 Extreme — Smallest file size</option>
      <option value="medium" selected>⚖️ Standard — Balanced quality</option>
      <option value="high">✨ High Quality — Minimal compression</option>
    </select>
    <p class="mt-2 text-xs text-slate-400">☁️ Uploaded over the network and deleted after processing.</p>
    <button
      id="cmp-btn"
      type="button"
      class="mt-4 w-full rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sky-700"
    >
      Compress &amp; Download
    </button>
    <div id="cmp-result" class="mt-4 hidden rounded-xl border border-slate-200 p-4 text-center dark:border-slate-700"></div>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Compress PDF</h2>
    <p id="cmp-rail" class="mt-1 text-xs text-slate-500 dark:text-slate-400">No file loaded.</p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-600 dark:bg-sky-500/10 dark:text-sky-400"
    >
      ☁️ Server · auto-deleted
    </span>
  </div>

  <script>
    import "../scripts/tools/compress-pdf";
  </script>
</ToolPage>
