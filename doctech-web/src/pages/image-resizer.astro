---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Image Resizer"
  subtitle="Resize an image to exact pixels or a percentage, with aspect-ratio lock. Runs entirely locally in your browser."
>
  <!-- Dropzone -->
  <label
    id="rsz-drop"
    for="rsz-input"
    class="group relative flex cursor-pointer flex-col items-center justify-center gap-4 overflow-hidden rounded-3xl border-2 border-dashed border-slate-300/70 bg-gradient-to-b from-slate-50 to-slate-100/50 px-8 py-24 text-center transition-all duration-300 hover:border-blue-500 hover:bg-blue-50/50 dark:border-slate-700 dark:from-slate-900/80 dark:to-slate-800/50 dark:hover:border-blue-500/50 dark:hover:bg-slate-800/80"
  >
    <div class="absolute inset-0 bg-[radial-gradient(slate-300_1px,transparent_1px)] [background-size:16px_16px] opacity-20 dark:bg-[radial-gradient(slate-600_1px,transparent_1px)]"></div>
    <div class="relative flex h-20 w-20 items-center justify-center rounded-2xl bg-white shadow-xl shadow-slate-200/50 transition-transform duration-300 group-hover:-translate-y-1 group-hover:scale-105 dark:bg-slate-800 dark:shadow-slate-900/50">
      <span class="text-4xl drop-shadow-sm">📐</span>
    </div>
    <div class="relative z-10 space-y-1">
      <p class="text-xl font-bold text-slate-700 dark:text-slate-200">Drop your image here</p>
      <p class="text-sm font-medium text-slate-500 dark:text-slate-400">or click to browse from your device</p>
    </div>
    <div class="relative z-10 mt-2 flex gap-2">
      <span class="rounded-lg bg-white/60 px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm backdrop-blur-md dark:bg-slate-800/60 dark:text-slate-300">JPG</span>
      <span class="rounded-lg bg-white/60 px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm backdrop-blur-md dark:bg-slate-800/60 dark:text-slate-300">PNG</span>
      <span class="rounded-lg bg-white/60 px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm backdrop-blur-md dark:bg-slate-800/60 dark:text-slate-300">WEBP</span>
    </div>
    <input id="rsz-input" type="file" accept="image/png,image/jpeg,image/webp,image/bmp" class="hidden" />
  </label>

  <!-- Workspace -->
  <div id="rsz-work" class="hidden">
    <div class="relative flex min-h-[400px] w-full items-center justify-center overflow-hidden rounded-3xl border border-slate-200 bg-[repeating-conic-gradient(#e2e8f0_0_25%,transparent_0_50%)] bg-[length:20px_20px] p-6 lg:min-h-[600px] dark:border-slate-800 dark:bg-[repeating-conic-gradient(#1e293b_0_25%,transparent_0_50%)]">
      <img id="rsz-preview" alt="preview" class="max-h-[500px] max-w-full rounded-lg object-contain shadow-2xl transition-transform duration-300" />
      
      <!-- Badges -->
      <div class="pointer-events-none absolute inset-x-4 top-4 flex justify-between">
        <span class="rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white shadow-lg backdrop-blur-md">Preview</span>
        <span id="rsz-badge-dims" class="rounded-full bg-blue-500/90 px-3 py-1 text-xs font-semibold text-white shadow-lg shadow-blue-500/20 backdrop-blur-md">—</span>
      </div>
    </div>
  </div>

  <!-- Rail -->
  <div slot="rail" class="flex flex-col gap-5">
    <!-- Dimensions Card -->
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="mb-5 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Dimensions</h3>
        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">Local</span>
      </div>

      <!-- Segmented Control for Units -->
      <div class="mb-5 flex items-center justify-between">
        <div id="rsz-unit-group" class="inline-flex rounded-xl border border-slate-200 bg-slate-50 p-1 dark:border-slate-700 dark:bg-slate-800/50">
          <button type="button" data-val="px" class="rounded-lg px-4 py-1.5 text-xs font-bold transition-all">Pixels (px)</button>
          <button type="button" data-val="%" class="rounded-lg px-4 py-1.5 text-xs font-bold transition-all">Percent (%)</button>
        </div>
        
        <button id="rsz-lock" type="button" aria-pressed="true" class="group flex items-center justify-center rounded-xl bg-blue-500 p-2 text-white shadow-md shadow-blue-500/20 transition-all hover:-translate-y-0.5 hover:shadow-blue-500/40" title="Lock aspect ratio">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a5 5 0 00-5 5v2a2 2 0 00-2 2v5a2 2 0 002 2h10a2 2 0 002-2v-5a2 2 0 00-2-2H7V7a3 3 0 015.905-.75 1 1 0 001.937-.5A5.002 5.002 0 0010 2z" />
          </svg>
        </button>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" for="rsz-w">Width</label>
          <div class="relative">
            <input id="rsz-w" type="number" min="1" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 outline-none transition-all focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-200 dark:focus:border-blue-500" />
            <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-xs font-bold text-slate-400" id="rsz-w-unit">px</span>
          </div>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400" for="rsz-h">Height</label>
          <div class="relative">
            <input id="rsz-h" type="number" min="1" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 outline-none transition-all focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-200 dark:focus:border-blue-500" />
            <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-xs font-bold text-slate-400" id="rsz-h-unit">px</span>
          </div>
        </div>
      </div>

      <!-- Quick Scale Buttons -->
      <div class="mt-5">
        <label class="mb-2 block text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">Quick Scale</label>
        <div class="grid grid-cols-4 gap-2">
          {[25, 50, 75, 100].map((p) => (
            <button type="button" data-scale={p} class="rounded-xl border border-slate-200 bg-slate-50 py-2 text-xs font-bold text-slate-600 transition-colors hover:border-blue-500 hover:bg-blue-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:bg-blue-500/10 dark:hover:text-blue-400">{p}%</button>
          ))}
        </div>
      </div>
    </div>

    <!-- Stats Card -->
    <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="h-2 w-2 rounded-full bg-slate-300 dark:bg-slate-600"></div>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Original Size</span>
          </div>
          <span id="rsz-orig" class="font-mono text-sm font-bold text-slate-700 dark:text-slate-200">—</span>
        </div>
        <div class="flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <div class="h-2 w-2 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.5)]"></div>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">New Size</span>
          </div>
          <span id="rsz-dims" class="font-mono text-sm font-bold text-blue-600 dark:text-blue-400">—</span>
        </div>
        <div class="flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-800">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Est. File Size</span>
          </div>
          <span id="rsz-filesize" class="font-mono text-sm font-bold text-slate-700 dark:text-slate-200">—</span>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="space-y-3">
      <button id="rsz-download" type="button" disabled class="group relative flex w-full items-center justify-center gap-2 overflow-hidden rounded-2xl bg-blue-500 px-4 py-4 text-sm font-bold text-white shadow-lg shadow-blue-500/30 transition-all hover:-translate-y-0.5 hover:shadow-blue-500/40 active:translate-y-0 disabled:pointer-events-none disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none dark:disabled:bg-slate-800 dark:disabled:text-slate-600">
        <svg class="h-5 w-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        Download Image
        <div class="absolute inset-0 -translate-x-full bg-white/20 transition-transform duration-500 ease-in-out group-hover:translate-x-full"></div>
      </button>
      <button id="rsz-reset" type="button" class="hidden w-full rounded-2xl border border-slate-200 bg-transparent px-4 py-3.5 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
        Resize Another
      </button>
    </div>
  </div>

  <script>
    import "../scripts/tools/image-resizer";
  </script>
</ToolPage>
