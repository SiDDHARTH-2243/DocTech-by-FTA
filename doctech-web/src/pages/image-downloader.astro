---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Image Downloader by URL"
  subtitle="Paste a direct image link to preview and download it — even from sites that normally block right-click saving. Works for direct image URLs."
>
  <div class="flex flex-col gap-2 sm:flex-row">
    <input
      id="idl-url"
      type="text"
      placeholder="https://example.com/photo.jpg"
      class="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
    />
    <button id="idl-load" type="button" class="rounded-xl bg-orange-500 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600">Preview</button>
  </div>

  <div id="idl-work" class="mt-6 hidden space-y-4">
    <div class="flex min-h-[240px] items-center justify-center overflow-auto rounded-2xl border border-slate-200 bg-slate-100 p-3 dark:border-slate-700 dark:bg-slate-950">
      <img id="idl-preview" alt="Preview" class="max-h-[440px] max-w-full rounded-lg" />
    </div>
    <button id="idl-download" type="button" class="w-full rounded-xl bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-orange-600">Download image</button>
  </div>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
    <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-1 font-semibold text-sky-600 dark:bg-sky-500/10 dark:text-sky-400">☁️ Server-assisted</span>
    The image is fetched through the DocTech server so cross-origin links download cleanly. It is streamed straight to you and not stored. This works with <strong>direct image URLs</strong>, not page links (e.g. paste the image address, not the post page).
  </div>

  <script>
    import "../scripts/tools/image-downloader";
  </script>
</CenteredTool>
