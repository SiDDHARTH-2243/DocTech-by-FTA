---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Find & Replace Text"
  subtitle="Search and replace across any text — with regex, case-insensitive and whole-word options, a live match count and highlighted preview. Everything stays in your browser."
>
  <div class="mb-4 flex items-center gap-2">
    <span class="local-chip">🔒 100% in your browser</span>
    <span class="text-xs text-slate-400 dark:text-slate-500">nothing is uploaded</span>
  </div>

  <div class="space-y-5">
    <div class="tool-panel">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="field-label" for="fr-find">Find</label>
          <input id="fr-find" type="text" spellcheck="false" placeholder="text or /regex/" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 font-mono text-sm outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100" />
        </div>
        <div>
          <label class="field-label" for="fr-replace">Replace with</label>
          <input id="fr-replace" type="text" spellcheck="false" placeholder="replacement ($1 in regex mode)" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 font-mono text-sm outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100" />
        </div>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300"><input type="checkbox" id="fr-regex" class="h-4 w-4 accent-orange-500" /> Regex</label>
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300"><input type="checkbox" id="fr-ci" class="h-4 w-4 accent-orange-500" checked /> Ignore case</label>
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300"><input type="checkbox" id="fr-word" class="h-4 w-4 accent-orange-500" /> Whole word</label>
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300"><input type="checkbox" id="fr-highlight" class="h-4 w-4 accent-orange-500" checked /> Highlight matches</label>
        <span id="fr-count" class="ml-auto rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">0 matches</span>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <div class="tool-panel flex min-w-0 flex-col">
        <label class="field-label" for="fr-in">Input</label>
        <textarea id="fr-in" rows="14" spellcheck="false" placeholder="Paste your text…" class="w-full flex-1 resize-y rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm leading-6 outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"></textarea>
        <div id="fr-preview" class="mt-2 hidden max-h-40 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-slate-50 px-3 py-2.5 font-mono text-xs leading-6 dark:bg-slate-800/50"></div>
      </div>
      <div class="tool-panel flex min-w-0 flex-col">
        <label class="field-label" for="fr-out">Result</label>
        <textarea id="fr-out" rows="14" readonly class="w-full flex-1 resize-y rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-sm leading-6 outline-none dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-100"></textarea>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <button type="button" id="fr-copy" class="btn-premium">Copy result</button>
          <button type="button" id="fr-download" class="btn-premium-ghost">Download .txt</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/find-replace";
  </script>
</CenteredTool>
