---
import ToolPage from "../components/ToolPage.astro";
import PremiumDropzone from "../components/PremiumDropzone.astro";
---

<ToolPage
  title="Image Average Color Finder"
  subtitle="Calculate the average / dominant color of an image. Get HEX, RGB and HSL values instantly — all in your browser."
>
  <PremiumDropzone
    dropId="avg-drop"
    inputId="avg-input"
    accept="image/png,image/jpeg,image/webp,image/bmp,image/gif"
    formats={["JPG", "PNG", "WEBP"]}
    icon="🎨"
    title="Drop your image here"
    hint="or click to browse from your device"
  />

  <div id="avg-work" class="hidden space-y-4">
    <div class="preview-stage min-h-[200px]">
      <img id="avg-preview" alt="preview" class="max-h-[300px] max-w-full rounded-lg object-contain" />
    </div>

    <div class="overflow-hidden rounded-3xl border border-slate-200 shadow-sm dark:border-slate-800">
      <div id="avg-swatch" class="flex h-32 items-center justify-center text-sm font-semibold"></div>
      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        {[
          ["HEX", "avg-hex"],
          ["RGB", "avg-rgb"],
          ["HSL", "avg-hsl"],
        ].map(([label, id]) => (
          <div class="flex items-center justify-between bg-white px-4 py-3 dark:bg-slate-900">
            <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">{label}</span>
            <button data-copy={id} type="button" class="rounded-lg border border-slate-200 px-3 py-1.5 font-mono text-xs font-semibold text-slate-700 transition-colors hover:border-orange-400 hover:text-orange-600 dark:border-slate-700 dark:text-slate-200 dark:hover:text-orange-400">
              <span id={id}>—</span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div slot="rail" class="flex flex-col gap-5">
    <div class="tool-panel">
      <div class="mb-3 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Average Color</h3>
        <span class="local-badge">⚡ Local</span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400">Click any value to copy it.</p>
      <button id="avg-reset" type="button" class="btn-premium-ghost mt-4 hidden">Choose another image</button>
    </div>
  </div>

  <script>
    import "../scripts/tools/image-average-color";
  </script>
</ToolPage>
