---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Hashtag Generator"
  subtitle="Type a few keywords and get a ready-to-paste set of relevant, popular hashtags for Instagram, TikTok and more."
>
  <div class="flex flex-col gap-2 sm:flex-row">
    <input
      id="hg-input"
      type="text"
      placeholder="travel, sunset, photography"
      class="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
    />
    <select id="hg-count" class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
      <option value="10">10 tags</option><option value="20" selected>20 tags</option><option value="30">30 tags</option>
    </select>
  </div>

  <div class="mt-5 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
    <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2 dark:border-slate-700 dark:bg-slate-800">
      <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase"><span id="hg-num">0</span> hashtags</span>
      <button id="hg-copy" type="button" class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-semibold text-white hover:bg-orange-600">Copy</button>
    </div>
    <div id="hg-out" class="flex flex-wrap gap-1.5 px-4 py-4 text-sm text-sky-600 dark:text-sky-400"></div>
  </div>

  <script>
    import "../scripts/tools/hashtag-generator";
  </script>
</CenteredTool>
