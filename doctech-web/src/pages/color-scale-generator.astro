---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Color Scale Generator"
  subtitle="Interpolate an even scale of colors between two or more stops — perfect for data-viz ramps, gradients-as-swatches and design tokens. RGB or HSL blending."
>
  <div class="mb-4 flex items-center gap-2">
    <span class="local-chip">🔒 100% in your browser</span>
    <span class="text-xs text-slate-400 dark:text-slate-500">for data-viz ramps &amp; tokens</span>
  </div>

  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-end gap-x-6 gap-y-4">
        <div>
          <label class="field-label">Stops</label>
          <div id="cs-stops" class="flex flex-wrap items-center gap-2"></div>
        </div>
        <button type="button" id="cs-add" class="rounded-xl border border-slate-200 px-3 py-2 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">＋ Stop</button>

        <div>
          <label class="field-label" for="cs-steps">Steps: <span id="cs-steps-val" class="font-mono text-slate-500">9</span></label>
          <input id="cs-steps" type="range" min="3" max="24" value="9" class="w-40 accent-orange-500" />
        </div>
        <div>
          <label class="field-label" for="cs-space">Blend in</label>
          <select id="cs-space" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-orange-500 dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100">
            <option value="rgb">RGB (linear)</option>
            <option value="hsl">HSL (through hues)</option>
          </select>
        </div>
      </div>
    </div>

    <div id="cs-bar" class="flex h-24 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700"></div>

    <div class="tool-panel">
      <div class="mb-3 flex items-center justify-between">
        <span class="field-label !mb-0">Swatches <span class="font-normal normal-case text-slate-400">— click to copy</span></span>
        <div class="flex gap-2">
          <button type="button" id="cs-copy-css" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Copy CSS array</button>
          <button type="button" id="cs-copy-json" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Copy JSON</button>
        </div>
      </div>
      <div id="cs-swatches" class="grid grid-cols-3 gap-2 sm:grid-cols-6 lg:grid-cols-9"></div>
    </div>
  </div>

  <script>
    import "../scripts/tools/color-scale-generator";
  </script>
</CenteredTool>
