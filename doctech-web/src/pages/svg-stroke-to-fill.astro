---
import ToolPage from "../components/ToolPage.astro";
import PremiumDropzone from "../components/PremiumDropzone.astro";
---

<ToolPage
  title="SVG Stroke to Fill"
  subtitle="Convert stroked SVG paths into filled outline paths — handy for laser cutting, fonts, or editing icons. Upload a file or paste markup. Fully in-browser."
>
  <PremiumDropzone
    dropId="stf-drop"
    inputId="stf-input"
    accept="image/svg+xml,.svg"
    formats={["SVG"]}
    icon="🖊️"
    title="Drop your SVG here"
    hint="or click to browse from your device"
  />

  <div class="my-3 text-center text-xs font-semibold text-slate-400">— or paste SVG code —</div>
  <textarea id="stf-paste" rows="4" placeholder="<svg …>…</svg>" class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 font-mono text-xs outline-none transition-all focus:border-orange-500 focus:ring-4 focus:ring-orange-500/10 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"></textarea>

  <div id="stf-work" class="mt-4 hidden space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <div class="mb-1.5 text-xs font-semibold tracking-wide text-slate-400 uppercase">Original (stroked)</div>
        <div id="stf-before" class="preview-stage min-h-[200px] [&_svg]:max-h-[200px] [&_svg]:max-w-full"></div>
      </div>
      <div>
        <div class="mb-1.5 text-xs font-semibold tracking-wide text-slate-400 uppercase">Outlined (filled)</div>
        <div id="stf-after" class="preview-stage min-h-[200px] [&_svg]:max-h-[200px] [&_svg]:max-w-full"></div>
      </div>
    </div>

    <div class="overflow-hidden rounded-3xl border border-slate-200 shadow-sm dark:border-slate-800">
      <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2.5 dark:border-slate-800 dark:bg-slate-800/60">
        <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Output SVG</span>
        <div class="flex gap-2">
          <button id="stf-copy" type="button" disabled class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-bold text-white shadow-sm shadow-orange-500/30 transition-all hover:-translate-y-0.5 hover:bg-orange-600 disabled:translate-y-0 disabled:bg-slate-200 disabled:text-slate-400 disabled:shadow-none dark:disabled:bg-slate-800 dark:disabled:text-slate-600">Copy</button>
          <button id="stf-download" type="button" disabled class="rounded-lg border border-slate-200 px-3 py-1 text-xs font-bold text-slate-600 transition-colors hover:border-orange-400 hover:text-orange-600 disabled:opacity-50 dark:border-slate-700 dark:text-slate-300 dark:hover:text-orange-400">Download</button>
        </div>
      </div>
      <pre id="stf-code" class="max-h-44 overflow-auto bg-white px-4 py-3 font-mono text-xs whitespace-pre-wrap dark:bg-slate-900 dark:text-slate-100"></pre>
    </div>
  </div>

  <div slot="rail" class="flex flex-col gap-5">
    <div class="tool-panel">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="font-bold text-slate-800 dark:text-slate-100">Stroke → Fill</h3>
        <span class="local-badge">⚡ Local</span>
      </div>
      <dl class="space-y-3 text-sm">
        <div class="flex items-center justify-between"><dt class="text-slate-500 dark:text-slate-400">Paths outlined</dt><dd id="stf-count" class="font-mono font-semibold text-orange-500">0</dd></div>
      </dl>
      <p class="mt-3 text-xs text-slate-400">Best-effort: outlines are sampled from path geometry. Complex caps, joins and dashes are approximated.</p>
    </div>
  </div>

  <script>
    import "../scripts/tools/svg-stroke-to-fill";
  </script>
</ToolPage>
