---
import ToolPage from "../components/ToolPage.astro";
---

<ToolPage
  title="Word to PDF"
  subtitle="Convert Microsoft Word (.docx) documents into PDF files, retaining formatting. Runs on the secure cloud engine."
>
  <label
    id="w2p-dropzone"
    for="w2p-input"
    class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center transition-colors hover:border-sky-400 dark:border-slate-700 dark:bg-slate-900"
  >
    <span class="text-3xl">📃</span>
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      Drag &amp; drop a Word file here, or click to browse
    </span>
    <span class="text-xs text-slate-400">.doc / .docx</span>
    <input
      id="w2p-input"
      type="file"
      accept=".doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      class="hidden"
    />
  </label>

  <div id="w2p-opts" class="mt-5 hidden">
    <p id="w2p-info" class="mb-4 text-sm font-semibold text-sky-700 dark:text-sky-400"></p>
    <div class="mb-4 flex h-[140px] w-[110px] items-center justify-center rounded-lg border-2 border-sky-500 bg-sky-50 text-2xl font-black text-sky-600 dark:bg-sky-500/10">
      DOCX
    </div>
    <p class="text-xs text-slate-400">☁️ Uploaded over the network and deleted after conversion.</p>
    <button
      id="w2p-btn"
      type="button"
      class="mt-4 w-full rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sky-700"
    >
      Convert to PDF
    </button>
  </div>

  <div
    slot="rail"
    class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
  >
    <h2 class="text-sm font-semibold">Word to PDF</h2>
    <p id="w2p-rail" class="mt-1 text-xs text-slate-500 dark:text-slate-400">No file loaded.</p>
    <span
      class="mt-3 inline-flex items-center gap-1 rounded-full bg-sky-50 px-2.5 py-1 text-[11px] font-semibold text-sky-600 dark:bg-sky-500/10 dark:text-sky-400"
    >
      ☁️ Server · auto-deleted
    </span>
  </div>

  <script>
    import "../scripts/tools/word-to-pdf";
  </script>
</ToolPage>
