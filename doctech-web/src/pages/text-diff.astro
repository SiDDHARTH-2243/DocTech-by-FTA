---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="Text & Code Diff Checker"
  subtitle="Compare two blocks of text or code line by line, with word-level highlighting inside changed lines. Side-by-side or unified view."
>
  <div class="space-y-5">
    <div class="grid gap-5 lg:grid-cols-2">
      <CodePane id="df-a" label="Original" placeholder="Paste the original text…" rows={12} actions={["sample", "upload", "clear"]} counts />
      <CodePane id="df-b" label="Changed" placeholder="Paste the changed text…" rows={12} actions={["sample", "upload", "clear"]} counts />
    </div>

    <div class="tool-panel">
      <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex rounded-xl border border-slate-200 p-1 dark:border-slate-700">
          <button type="button" data-view="split" class="df-view rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="true">Side by side</button>
          <button type="button" data-view="unified" class="df-view rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="false">Unified</button>
        </div>

        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <input type="checkbox" id="df-case" class="h-4 w-4 accent-orange-500" />
          Ignore case
        </label>
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <input type="checkbox" id="df-ws" class="h-4 w-4 accent-orange-500" />
          Ignore whitespace
        </label>
        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <input type="checkbox" id="df-words" class="h-4 w-4 accent-orange-500" checked />
          Word-level highlight
        </label>

        <div class="ml-auto flex flex-wrap items-center gap-2">
          <span id="df-stat-add" class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-300">+0</span>
          <span id="df-stat-del" class="rounded-full bg-red-50 px-2.5 py-1 text-[11px] font-bold text-red-600 dark:bg-red-500/10 dark:text-red-300">−0</span>
          <span id="df-stat-same" class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-500 dark:bg-slate-800 dark:text-slate-400">0 unchanged</span>
          <button type="button" id="df-swap" class="rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">⇅ Swap</button>
        </div>
      </div>
    </div>

    <div class="tool-panel !p-0">
      <div id="df-out" class="overflow-x-auto rounded-3xl font-mono text-xs leading-6">
        <p class="px-5 py-8 text-center text-sm text-slate-500 dark:text-slate-400">
          Paste text into both panes to see the differences.
        </p>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/text-diff";
  </script>
</CenteredTool>
