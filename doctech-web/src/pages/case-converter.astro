---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  title="Case Converter"
  subtitle="Convert your text to UPPERCASE, lowercase, Title Case, Sentence case and more."
>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
    <textarea
      id="cc-input"
      rows="5"
      placeholder="Type or paste your text here…"
      class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-orange-400 focus:ring-2 focus:ring-orange-200 focus:outline-none dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100 dark:focus:ring-orange-500/30"
    >hello world. this is doctech.</textarea>

    <div id="cc-modes" class="mt-4 flex flex-wrap gap-2">
      {
        [
          ["upper", "UPPERCASE"],
          ["lower", "lowercase"],
          ["title", "Title Case"],
          ["sentence", "Sentence case"],
          ["camel", "camelCase"],
          ["snake", "snake_case"],
          ["kebab", "kebab-case"],
          ["alt", "AlTeRnAtInG"],
        ].map(([mode, label]) => (
          <button
            type="button"
            data-mode={mode}
            class="cc-mode rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {label}
          </button>
        ))
      }
    </div>

    <textarea
      id="cc-output"
      rows="5"
      readonly
      class="mt-4 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-800/50 dark:text-slate-100"
    ></textarea>
    <button
      id="cc-copy"
      type="button"
      class="mt-3 rounded-xl bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-orange-600"
    >
      Copy result
    </button>
  </div>

  <script>
    import "../scripts/tools/case-converter";
  </script>
</CenteredTool>
