---
import CenteredTool from "../components/CenteredTool.astro";
---

<CenteredTool
  wide
  title="Neumorphism Generator"
  subtitle="Design soft-UI (neumorphism) shadows — pick a base color, light direction and surface, or start from a preset."
>
  <div class="lg:grid lg:grid-cols-[1fr_minmax(0,440px)] lg:items-start lg:gap-6">
    <!-- LEFT: preview on top, presets below -->
    <div class="space-y-5 lg:sticky lg:top-4">
      <div id="nm-stage" class="flex min-h-[300px] items-center justify-center rounded-2xl transition-colors">
        <div id="nm-preview" class="flex items-center justify-center text-sm font-semibold"></div>
      </div>

      <!-- Preset gallery -->
      <div>
        <div class="mb-2 flex items-center justify-between">
          <span class="text-sm font-semibold">Presets</span>
          <div class="flex gap-2">
            <button id="nm-shuffle" type="button" class="rounded-lg border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">🎲 Shuffle</button>
            <button id="nm-reset" type="button" class="rounded-lg border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-800">Reset</button>
          </div>
        </div>
        <div id="nm-presets" class="grid grid-cols-3 gap-3 sm:grid-cols-4"></div>
      </div>
    </div>

    <!-- RIGHT: settings beside preview, code below settings -->
    <div class="mt-5 space-y-5 lg:mt-0">
      <!-- Controls -->
      <div class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-2 dark:border-slate-800 dark:bg-slate-900">
        <!-- Base color -->
        <div>
          <label class="mb-1.5 block text-sm font-semibold" for="nm-color">Base color</label>
          <div class="flex items-center gap-2">
            <input id="nm-color" type="color" value="#e0e5ec" class="h-10 w-14 cursor-pointer rounded-lg border border-slate-300 bg-transparent dark:border-slate-700" />
            <span id="nm-color-hex" class="font-mono text-sm text-slate-500">#e0e5ec</span>
          </div>
        </div>

        <!-- Light source -->
        <div>
          <span class="mb-1.5 block text-sm font-semibold">Light source</span>
          <div id="nm-light" class="relative h-16 w-16 rounded-xl border border-slate-200 bg-slate-50 dark:border-slate-700 dark:bg-slate-800">
            <button type="button" data-corner="tl" aria-label="Top left" class="absolute left-1 top-1 h-3 w-3 rounded-full"></button>
            <button type="button" data-corner="tr" aria-label="Top right" class="absolute right-1 top-1 h-3 w-3 rounded-full"></button>
            <button type="button" data-corner="bl" aria-label="Bottom left" class="absolute bottom-1 left-1 h-3 w-3 rounded-full"></button>
            <button type="button" data-corner="br" aria-label="Bottom right" class="absolute bottom-1 right-1 h-3 w-3 rounded-full"></button>
          </div>
        </div>

        <!-- Surface -->
        <div>
          <span class="mb-1.5 block text-sm font-semibold">Surface</span>
          <div id="nm-shape-group" class="inline-flex rounded-lg border border-slate-300 p-0.5 dark:border-slate-700">
            <button type="button" data-val="flat" class="rounded-md px-2.5 py-1 text-xs font-semibold">Flat</button>
            <button type="button" data-val="concave" class="rounded-md px-2.5 py-1 text-xs font-semibold">Concave</button>
            <button type="button" data-val="convex" class="rounded-md px-2.5 py-1 text-xs font-semibold">Convex</button>
          </div>
        </div>

        <!-- State -->
        <div>
          <span class="mb-1.5 block text-sm font-semibold">State</span>
          <div id="nm-type-group" class="inline-flex rounded-lg border border-slate-300 p-0.5 dark:border-slate-700">
            <button type="button" data-val="raised" class="rounded-md px-2.5 py-1 text-xs font-semibold">Raised</button>
            <button type="button" data-val="pressed" class="rounded-md px-2.5 py-1 text-xs font-semibold">Pressed</button>
          </div>
        </div>

        <!-- Sliders -->
        {
          [
            ["nm-size", "Size", 80, 280, 200, "px"],
            ["nm-dist", "Distance", 2, 60, 20, "px"],
            ["nm-intensity", "Intensity", 2, 18, 8, ""],
            ["nm-blur", "Blur", 0, 120, 40, "px"],
            ["nm-radius", "Radius", 0, 140, 30, "px"],
          ].map(([id, label, min, max, val, unit]) => (
            <div>
              <label class="mb-1.5 block text-sm font-semibold" for={id}>
                {label} <span id={`${id}-val`} class="text-orange-500">{val}</span>{unit}
              </label>
              <input id={id} type="range" min={min} max={max} value={val} class="w-full accent-orange-500" />
            </div>
          ))
        }
      </div>

      <!-- CSS output -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
        <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2 dark:border-slate-700 dark:bg-slate-800">
          <span class="text-xs font-semibold tracking-wide text-slate-400 uppercase">CSS</span>
          <button id="nm-copy" type="button" class="rounded-lg bg-orange-500 px-3 py-1 text-xs font-semibold text-white hover:bg-orange-600">Copy</button>
        </div>
        <pre id="nm-css" class="overflow-x-auto px-4 py-3 font-mono text-xs leading-relaxed dark:text-slate-100"></pre>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/neumorphism-generator";
  </script>
</CenteredTool>
