---
import CenteredTool from "../components/CenteredTool.astro";
import CodePane from "../components/CodePane.astro";
---

<CenteredTool
  wide
  title="Base64 Encoder & Decoder"
  subtitle="Encode or decode Base64 text and files — Unicode-safe, URL-safe variant supported, with instant data-URI output. Nothing leaves your device."
>
  <div class="space-y-5">
    <div class="tool-panel">
      <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex rounded-xl border border-slate-200 p-1 dark:border-slate-700" role="tablist">
          <button type="button" data-mode="encode" class="b64-mode rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="true">Encode</button>
          <button type="button" data-mode="decode" class="b64-mode rounded-lg px-4 py-1.5 text-sm font-bold transition-colors" aria-pressed="false">Decode</button>
        </div>

        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <input type="checkbox" id="b64-urlsafe" class="h-4 w-4 accent-orange-500" />
          URL-safe (<code class="font-mono text-xs">-_</code>, no padding)
        </label>

        <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <input type="checkbox" id="b64-wrap" class="h-4 w-4 accent-orange-500" />
          Wrap at 76 chars
        </label>

        <button type="button" id="b64-swap" class="ml-auto rounded-xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">⇅ Swap</button>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      <CodePane
        id="b64-in"
        label="Input"
        placeholder="Type or paste text…"
        rows={14}
        actions={["sample", "clear"]}
        counts
      />
      <CodePane
        id="b64-out"
        label="Output"
        variant="output"
        rows={14}
        actions={["copy", "download"]}
        counts
      />
    </div>

    <div class="tool-panel">
      <span class="field-label">Encode a file</span>
      <p class="mb-3 text-sm text-slate-500 dark:text-slate-400">
        Turn any file into Base64 or a ready-to-paste <code class="font-mono text-xs">data:</code> URI — useful for
        inlining images in CSS or HTML.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" id="b64-pick" class="rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-orange-600">Choose file…</button>
        <input type="file" id="b64-filein" class="hidden" />
        <span id="b64-fileinfo" class="text-sm text-slate-500 dark:text-slate-400">No file selected</span>
      </div>
      <div id="b64-fileout" class="mt-4 hidden">
        <div class="mb-2 flex items-center justify-between">
          <span class="field-label !mb-0">Data URI</span>
          <div class="flex gap-1.5">
            <button type="button" id="b64-file-copy" class="rounded-lg bg-orange-500 px-2.5 py-1 text-xs font-bold text-white transition-colors hover:bg-orange-600">Copy</button>
            <button type="button" id="b64-file-raw" class="rounded-lg border border-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Copy raw Base64</button>
          </div>
        </div>
        <textarea id="b64-file-text" rows="4" readonly class="w-full resize-y rounded-2xl border border-slate-200 bg-slate-50 px-3 py-3 font-mono text-xs leading-5 text-slate-700 outline-none dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-200"></textarea>
      </div>
    </div>
  </div>

  <script>
    import "../scripts/tools/base64-encoder";
  </script>
</CenteredTool>
