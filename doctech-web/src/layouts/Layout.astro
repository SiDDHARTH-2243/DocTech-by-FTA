---
import "../styles/global.css";
import "../styles/kivo.css";
import { brand, categories, catColor } from "../config/site";
import Logo from "../components/Logo.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * Lock the page to dark mode (the typing games depend on a neon-on-black
   * aesthetic; a light navbar over a black canvas looks broken). The forced
   * value is never persisted, and the navbar theme toggle is not rendered.
   */
  forceDark?: boolean;
}

const {
  title = `${brand.namePrefix}${brand.nameSuffix}`,
  forceDark = false,
} = Astro.props;

// Categories that have at least one ready tool — the slide-out sidebar browses
// tools by collapsible category, with a search box to filter across them.
const sidebarCats = categories.filter((c) => c.tools.some((t) => t.ready));

// Flatten the real registry for the global ⌘K command palette.
const paletteTools = categories.flatMap((c) =>
  c.tools
    .filter((t) => t.ready)
    .map((t) => ({
      name: t.name,
      cat: c.label,
      href: t.href,
      desc: t.description ?? "",
      icon: t.icon,
      color: catColor(c.id).color,
      soft: catColor(c.id).soft,
    })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="DocTech by FTA - Every tool you need. One private workspace for PDF, Image, and Text utilities." />
    <meta property="og:title" content="DocTech by FTA" />
    <meta property="og:description" content="Premium suite of private, in-browser tools designed to feel effortless." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://doc-tech-by-fta.vercel.app/" />
    <meta name="theme-color" content="#f4efe7" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {/* FOUC prevention: apply the saved theme before first paint (light default).
        On a `forceDark` route we lock to dark here — before anything renders, so
        the navbar never flashes light above a black game canvas — while
        remembering the user's real preference and restoring it on the way out.
        The forced value is deliberately never written to localStorage. */}
    <script is:inline define:vars={{ forceDark }}>
      (() => {
        const de = document.documentElement;
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const userWantsDark = saved === "dark" || (!saved && prefersDark);

        if (forceDark) {
          de.classList.add("dark", "theme-locked");
          window.addEventListener("pagehide", () => {
            de.classList.remove("theme-locked");
            if (!userWantsDark) de.classList.remove("dark");
          });
        } else if (userWantsDark) {
          de.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="antialiased">
    <header class="site-header" id="top">
      <div class="header-inner">
        <div class="header-left">
          <button class="sidebar-toggle icon-button" type="button" aria-label="Open tools menu" aria-expanded="false" aria-controls="appSidebar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>

        <div class="brand-wrap">
          <a class="brand" href="/" aria-label="DocTech home">
            <Logo />
            <span>{brand.namePrefix}<span class="accent">{brand.nameSuffix}</span></span>
          </a>
          <a class="brand-by" href="https://futuretechautomation.in/" target="_blank" rel="noopener noreferrer">by {brand.badge}</a>
        </div>

        <div class="header-actions">
          <button class="icon-button search-trigger" type="button" aria-label="Open search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/></svg>
            <span>Search tools</span>
            <kbd>⌘ K</kbd>
          </button>
          {/* Theme-locked routes don't render the toggle at all — nothing to click,
              nothing to break the aesthetic. */}
          {!forceDark && (
            <button class="icon-button theme-toggle" type="button" aria-label="Switch color theme">
              <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
              <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z"/></svg>
            </button>
          )}
          {/* Detour into the games — deliberately styled apart from the utility nav. */}
          <a class="arcade-link" href="/arcade" aria-label="The Arcade — typing games">
            <span class="arcade-bracket">[</span>ARCADE<span class="arcade-bracket">]</span>
          </a>
          <a class="button button-small button-ghost desktop-cta" href="/#tools">Explore tools</a>
        </div>
      </div>
    </header>

    <!-- Slide-out tool sidebar (available on every page) -->
    <div class="sidebar-backdrop" aria-hidden="true"></div>
    <aside id="appSidebar" class="app-sidebar" aria-hidden="true" aria-label="Jump to a tool">
      <div class="sidebar-head">
        <a class="sidebar-brand brand" href="/" aria-label="DocTech home">
          <Logo />
          <span>{brand.namePrefix}<span class="accent">{brand.nameSuffix}</span></span>
        </a>
        <button class="sidebar-close icon-button" type="button" aria-label="Close tools menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="sidebar-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/></svg>
        <input type="search" id="sidebarFilter" placeholder="Jump to a tool…" autocomplete="off" aria-label="Filter tools" />
      </div>
      <nav class="sidebar-nav" aria-label="Browse tools by category">
        <a class="sidebar-home" href="/">
          <span class="sidebar-cat-icon">🏠</span><span>Home</span>
        </a>
        {sidebarCats.map((c) => {
          const readyTools = c.tools.filter((t) => t.ready);
          return (
            <div class="sidebar-cat">
              <button class="sidebar-cat-btn" type="button" aria-expanded="false">
                <span class="sidebar-cat-icon" style={`background:${catColor(c.id).soft}`}>{c.icon}</span>
                <span class="sidebar-cat-label">{c.label}</span>
                <span class="sidebar-cat-count">{readyTools.length}</span>
                <svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </button>
              <div class="sidebar-cat-tools">
                <div class="sidebar-cat-tools-inner">
                  {readyTools.map((t) => (
                    <a class="sidebar-tool" href={t.href} data-name={t.name.toLowerCase()}>
                      <span class="sidebar-tool-icon">{t.icon}</span>
                      <span>{t.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
        <p class="sidebar-empty" hidden>No tool matches that.</p>
      </nav>
    </aside>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/"><Logo /><span>{brand.namePrefix}<span class="accent">{brand.nameSuffix}</span></span></a>
          <p>Small tools. Beautifully made.<br />Private, in-browser utilities for everyday work.</p>
          <div class="social-links"><a href="/#tools" aria-label="Tools">✦</a><a href="/#categories" aria-label="Categories">▦</a><a href="/#why" aria-label="About">i</a></div>
        </div>
        <div><h4>Categories</h4>{categories.filter((c) => c.tools.length > 0).slice(0, 5).map((c) => <a href="/#categories">{c.label}</a>)}</div>
        <div><h4>Explore</h4><a href="/#tools">All tools</a><a href="/#categories">Browse categories</a><a href="/#why">Why DocTech</a></div>
        <div><h4>Suite</h4><a href="/#top">Overview</a><a href="/#tools">Search a tool</a><a href="/#why">Privacy</a></div>
      </div>
      <div class="container footer-bottom">
        <p>© 2026 {brand.namePrefix}{brand.nameSuffix}. Crafted with care.</p>
        <div><span class="status-dot"></span> All systems operational</div>
      </div>
    </footer>

    <div class="command-overlay" id="commandOverlay" aria-hidden="true">
      <div class="command-backdrop"></div>
      <div class="command-dialog" role="dialog" aria-modal="true" aria-label="Search tools">
        <div class="command-input-wrap">
          <svg viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/></svg>
          <input type="search" id="commandInput" placeholder="Search for a tool…" autocomplete="off" />
          <kbd>ESC</kbd>
        </div>
        <div class="command-results" id="commandResults"></div>
        <div class="command-footer"><span>↑↓ Navigate</span><span>↵ Open</span><span>ESC Close</span></div>
      </div>
    </div>

    <div class="toast" id="toast" role="status"><span>✓</span><p></p></div>

    <script type="application/json" id="__toolsdata" set:html={JSON.stringify(paletteTools)}></script>
    <script>
      import "../scripts/chrome";
    </script>
  </body>
</html>
